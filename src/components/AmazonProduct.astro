---
import { resolveProductImage } from '../lib/products';
import { getRating } from '../lib/ratings';
import { isAvailable, productUrl, searchUrl, queryFromTitle } from '../lib/availability';

interface Props {
  asin: string;
  title: string;
  image?: string;
  blurb?: string;
  pros?: string[];
  cons?: string[];
  award?: string;
  featured?: boolean;
  /** requête de repli propre au produit, si le produit n'est plus achetable */
  search?: string;
  /** repli par défaut : le mot-clé principal de l'article (ce que cherche le lecteur) */
  fallbackSearch?: string;
}

const { asin, title, image, blurb, pros = [], cons = [], award, featured = false, search, fallbackSearch } = Astro.props;
const ribbonLabel = award ?? 'Notre choix';

// Produit achetable -> lien vers la fiche (meilleure conversion).
// Produit en rupture constatée -> lien vers une recherche Amazon ciblée :
// le lecteur trouve un équivalent au lieu de tomber sur une impasse, et le
// lien reste rémunéré (les liens de recherche sont autorisés et commissionnés).
// Repli, par ordre de pertinence : requête explicite du frontmatter, sinon le
// mot-clé principal de l'article (« caisson de rangement sous bureau »), sinon
// la marque+modèle du titre en dernier recours.
const available = isAvailable(asin);
const affiliateUrl = available
  ? productUrl(asin)
  : searchUrl(search || fallbackSearch || queryFromTitle(title));

// Image produit : champ `image:` du frontmatter, sinon public/products/<ASIN>.<ext>
// détecté automatiquement (voir public/products/README.md).
const resolvedImage = resolveProductImage(asin, image);

// Note Amazon réelle (si récupérée par le process local). Jamais inventée.
const rating = getRating(asin);
const nf = new Intl.NumberFormat('fr-FR');
const ratingLabel = rating ? rating.rating.toFixed(1).replace('.', ',') : null;
const starPct = rating ? Math.round((rating.rating / 5) * 100) : 0;
---

<div class:list={['amazon-product', 'card', { 'amazon-product--featured': featured }]}>
  {(featured || award) && <span class="ribbon amazon-product__ribbon">{ribbonLabel}</span>}
  {resolvedImage && (
    <a href={affiliateUrl} target="_blank" rel="nofollow sponsored noopener" class="amazon-product__imgwrap">
      <img
        src={resolvedImage}
        alt={title}
        loading="lazy"
        onerror="this.closest('.amazon-product__imgwrap').remove()"
      />
    </a>
  )}
  <div class="amazon-product__body">
    <p class="eyebrow">Recommandation</p>
    <p class="amazon-product__title">{title}</p>
    {rating && (
      <p class="amazon-product__rating" title={`Note moyenne ${ratingLabel}/5 sur ${nf.format(rating.count)} avis Amazon`}>
        <span class="stars" aria-hidden="true"><span class="stars__on" style={`width:${starPct}%`}></span></span>
        <span class="amazon-product__rating-text"><strong>{ratingLabel}</strong>/5 · {nf.format(rating.count)} avis <span class="amazon-product__rating-src">sur Amazon</span></span>
      </p>
    )}
    {blurb && <p class="amazon-product__blurb">{blurb}</p>}
    {(pros.length > 0 || cons.length > 0) && (
      <div class="proscons">
        {pros.length > 0 && (
          <div class="proscons__col proscons__col--pro">
            <p class="proscons__title">On aime</p>
            <ul>{pros.map((p) => <li>{p}</li>)}</ul>
          </div>
        )}
        {cons.length > 0 && (
          <div class="proscons__col proscons__col--con">
            <p class="proscons__title">Ce qui peut gêner</p>
            <ul>{cons.map((c) => <li>{c}</li>)}</ul>
          </div>
        )}
      </div>
    )}
    {!available && (
      <p class="amazon-product__unavailable">
        Ce modèle n'est plus en stock chez Amazon. Le lien ci-dessous ouvre une recherche
        sur des modèles équivalents.
      </p>
    )}
    <a class="btn btn--primary amazon-product__cta" href={affiliateUrl} target="_blank" rel="nofollow sponsored noopener">
      {available ? 'Voir le prix sur Amazon →' : 'Voir les modèles équivalents →'}
    </a>
  </div>
</div>

<style>
  .amazon-product {
    position: relative;
    display: flex;
    gap: 1.25rem;
    align-items: center;
    padding: 1.25rem;
    margin: 1.75rem 0;
    flex-wrap: wrap;
  }
  .amazon-product--featured { border-color: var(--color-accent); box-shadow: var(--shadow-md); }
  .amazon-product__ribbon { position: absolute; top: -0.7rem; left: 1.25rem; }
  .amazon-product__imgwrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 110px;
    height: 110px;
    background: #fff;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .amazon-product img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    border-radius: 0;
  }
  .amazon-product__body { flex: 1; min-width: 180px; }
  .amazon-product__title { font-weight: 600; margin: 0.3rem 0 0.35rem; }
  .amazon-product__rating {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.55rem;
    font-size: 0.86rem;
    color: var(--color-text-muted);
  }
  .amazon-product__rating-text strong { color: var(--color-text); }
  .amazon-product__rating-src { opacity: 0.7; }
  /* étoiles : fond gris + calque doré découpé à la largeur = note/5 */
  .stars {
    position: relative;
    display: inline-block;
    font-size: 0.95rem;
    line-height: 1;
    letter-spacing: 1px;
    white-space: nowrap;
    color: color-mix(in srgb, var(--color-text-muted) 45%, transparent);
  }
  .stars::before { content: '★★★★★'; }
  .stars__on {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
    color: #f5a623;
  }
  .stars__on::before { content: '★★★★★'; }
  .amazon-product__blurb { color: var(--color-text-muted); margin: 0 0 0.9rem; font-size: 0.92rem; }
  .amazon-product__unavailable {
    margin: 0 0 0.9rem;
    padding: 0.55rem 0.75rem;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    background: color-mix(in srgb, var(--color-text-muted) 8%, transparent);
    border-left: 3px solid color-mix(in srgb, var(--color-text-muted) 45%, transparent);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .amazon-product__cta { font-size: 0.88rem; }

  /* ---- Points forts / limites (transparence) ---- */
  .proscons { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem 1.1rem; margin: 0 0 0.95rem; width: 100%; }
  .proscons__title { margin: 0 0 0.35rem; font-family: var(--font-display); font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; }
  .proscons__col--pro .proscons__title { color: #1a7f52; }
  .proscons__col--con .proscons__title { color: #b25f00; }
  .proscons ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.3rem; }
  .proscons li { position: relative; padding-left: 1.35em; font-size: 0.87rem; line-height: 1.45; color: var(--color-text-muted); }
  .proscons li::before { position: absolute; left: 0; top: 0; font-weight: 700; }
  .proscons__col--pro li::before { content: '✓'; color: #1a7f52; }
  .proscons__col--con li::before { content: '–'; color: #b25f00; }
  @media (max-width: 560px) { .proscons { grid-template-columns: 1fr; } }
</style>
