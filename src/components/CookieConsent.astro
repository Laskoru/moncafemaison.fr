---
// Bandeau de consentement minimal conforme RGPD.
// Tant que l'utilisateur n'a pas cliqué "Accepter", aucun script de mesure
// d'audience (Google Analytics, voir BaseLayout.astro) n'est chargé.
---

<div id="cookie-banner" class="cookie-banner" aria-hidden="true">
  <div class="cookie-banner__inner">
    <p>
      Ce site utilise des cookies de <strong>mesure d'audience</strong> (Google Analytics)
      pour comprendre comment il est consulté et l'améliorer. Ils ne sont déposés que si
      tu acceptes. Voir la
      <a href="/politique-de-confidentialite/">politique de confidentialité</a>.
    </p>
    <div class="cookie-banner__actions">
      <button id="cookie-refuse" type="button" class="cbtn cbtn--ghost">Refuser</button>
      <button id="cookie-accept" type="button" class="cbtn cbtn--accent">Accepter</button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'cookie-consent';
    var banner = document.getElementById('cookie-banner');
    var stored = localStorage.getItem(KEY);

    function reveal() {
      if (!stored) { banner.classList.add('is-visible'); banner.setAttribute('aria-hidden', 'false'); }
    }

    function setConsent(value) {
      localStorage.setItem(KEY, value);
      banner.classList.remove('is-visible');
      banner.setAttribute('aria-hidden', 'true');
      if (value === 'accepted') {
        document.dispatchEvent(new CustomEvent('cookie-consent-accepted'));
      }
    }

    document.getElementById('cookie-accept').addEventListener('click', function () {
      setConsent('accepted');
    });
    document.getElementById('cookie-refuse').addEventListener('click', function () {
      setConsent('refused');
    });

    if (stored === 'accepted') {
      document.dispatchEvent(new CustomEvent('cookie-consent-accepted'));
    }
    reveal();
  })();
</script>

<style>
  /* Hors écran par transform (pas de décalage de mise en page / CLS), glisse quand il faut demander le consentement. */
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1rem 1.25rem;
    background: var(--color-ink);
    color: var(--color-on-ink);
    transform: translateY(110%);
    visibility: hidden;
    transition: transform 0.35s var(--ease-out), visibility 0s linear 0.35s;
  }
  .cookie-banner.is-visible { transform: none; visibility: visible; transition: transform 0.35s var(--ease-out); }
  .cookie-banner__inner {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    justify-content: space-between;
  }
  .cookie-banner p { margin: 0; font-family: var(--font-ui); font-weight: 500; font-size: 0.9rem; line-height: 1.5; max-width: 66ch; color: var(--color-on-ink-muted); }
  .cookie-banner strong { color: var(--color-on-ink); }
  .cookie-banner a { color: var(--color-on-ink); }
  .cookie-banner__actions { display: flex; gap: 0.6rem; flex-shrink: 0; }
  .cbtn {
    min-height: 44px;
    padding: 0.6rem 1.1rem;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.92rem;
    border-radius: var(--radius);
    cursor: pointer;
  }
  .cbtn--accent { background: var(--color-accent); color: #fff; border: 1px solid var(--color-accent); }
  .cbtn--accent:hover { background: var(--color-accent-hover); }
  .cbtn--ghost { background: transparent; color: var(--color-on-ink); border: 1px solid var(--color-on-ink-muted); }
  .cbtn--ghost:hover { border-color: var(--color-on-ink); }
  .cbtn:focus-visible { outline-color: var(--color-accent-on-ink); }
</style>
