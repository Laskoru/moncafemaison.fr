---
// Bandeau de consentement minimal conforme RGPD.
// Tant que l'utilisateur n'a pas cliqué "Accepter", le script AdSense
// (voir BaseLayout.astro) n'est pas chargé.
---

<div id="cookie-banner" class="cookie-banner" hidden>
  <div class="cookie-banner__inner">
    <p>
      Ce site utilise des cookies pour afficher des publicités personnalisées.
      Vous pouvez accepter ou refuser leur utilisation. Voir notre
      <a href="/politique-de-confidentialite">politique de confidentialité</a>.
    </p>
    <div class="cookie-banner__actions">
      <button id="cookie-refuse" type="button" class="btn btn--ghost">Refuser</button>
      <button id="cookie-accept" type="button" class="btn btn--accent">Accepter</button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'cookie-consent';
    var banner = document.getElementById('cookie-banner');
    var stored = localStorage.getItem(KEY);

    function reveal() {
      if (!stored) banner.hidden = false;
    }

    function setConsent(value) {
      localStorage.setItem(KEY, value);
      banner.hidden = true;
      if (value === 'accepted') {
        document.dispatchEvent(new CustomEvent('cookie-consent-accepted'));
      }
    }

    document.getElementById('cookie-accept').addEventListener('click', function () {
      setConsent('accepted');
    });
    document.getElementById('cookie-refuse').addEventListener('click', function () {
      setConsent('refused');
    });

    if (stored === 'accepted') {
      document.dispatchEvent(new CustomEvent('cookie-consent-accepted'));
    }
    reveal();
  })();
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #191c22;
    color: white;
    z-index: 100;
    padding: 1rem 1.25rem;
  }
  .cookie-banner__inner {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }
  .cookie-banner p { margin: 0; font-size: 0.9rem; max-width: 640px; }
  .cookie-banner a { color: white; }
  .cookie-banner__actions { display: flex; gap: 0.5rem; flex-shrink: 0; }
  .btn {
    border: none;
    border-radius: var(--radius);
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .btn--accent { background: var(--color-accent); color: white; }
  .btn--ghost { background: transparent; color: white; border: 1px solid rgba(255,255,255,0.4); }
</style>
