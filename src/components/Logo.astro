---
// Marque Mon Café Maison : une tasse vue de dessus (anse à droite, disque de
// café et reflet de crema), cuivre sur encre, dans un carré arrondi.
// Mêmes formes que public/favicon.svg.
interface Props { size?: number; class?: string }
const { size = 32, class: cls } = Astro.props;
---

<svg class={cls} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <rect width="64" height="64" rx="14" fill="#20170f" />
  <circle cx="29" cy="33" r="17" fill="none" stroke="#a5531b" stroke-width="3" />
  <circle cx="29" cy="33" r="10" fill="#a5531b" />
  <path d="M23.5 29.5a8 8 0 0 1 6-4.5" fill="none" stroke="#fbf8f3" stroke-width="2" stroke-linecap="round" opacity="0.55" />
  <path d="M46 28.5h3a4.5 4.5 0 0 1 0 9h-3" fill="none" stroke="#a5531b" stroke-width="3" stroke-linecap="round" />
</svg>
