---
import { siteConfig } from '../siteConfig';
import { categories } from '../categories';
import { guides } from '../guides';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wide ftr__grid">
    <div class="ftr__brand">
      <a href="/" class="ftr__logo" aria-label={`${siteConfig.name} — accueil`}>
        <Logo size={30} />
        <span>{siteConfig.name}</span>
      </a>
      <p class="ftr__tagline">{siteConfig.tagline}. Comparatifs indépendants, notes Amazon réelles, méthode publiée.</p>
    </div>

    <nav class="ftr__col" aria-label="Catégories">
      <p class="ftr__heading">Catégories</p>
      {categories.map((cat) => (
        <a href={`/categorie/${cat.slug}/`}>{cat.label}</a>
      ))}
    </nav>

    <nav class="ftr__col" aria-label="Guides">
      <p class="ftr__heading">Guides</p>
      {guides.map((g) => (
        <a href={`/guides/${g.slug}/`}>{g.title}</a>
      ))}
      <a href="/methodes-cafe/">Quelle méthode de café ?</a>
    </nav>

    <nav class="ftr__col" aria-label="Le site">
      <p class="ftr__heading">Le site</p>
      <a href="/articles/">Tous les comparatifs</a>
      <a href="/outils/">Outils gratuits</a>
      <a href="/lexique/">Lexique</a>
      <a href="/a-propos/">À propos et méthode</a>
      <a href="/auteur/">L'auteur</a>
      <a href="/contact/">Contact</a>
      <a href="/rss.xml">Flux RSS</a>
    </nav>
  </div>

  <div class="wide ftr__bottom">
    <p>&copy; {year} {siteConfig.name}</p>
    <nav class="ftr__legal" aria-label="Mentions légales">
      <a href="/mentions-legales/">Mentions légales</a>
      <a href="/politique-de-confidentialite/">Confidentialité</a>
    </nav>
  </div>

  <p class="wide ftr__disclosure">
    En tant que Partenaire Amazon, {siteConfig.name} réalise un bénéfice sur les achats remplissant les
    conditions requises. Certains liens sont des liens affiliés.
  </p>
</footer>

<style>
  .ftr {
    margin-top: 4.5rem;
    padding: 3rem 0 2rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.92rem;
    color: var(--color-text-muted);
  }
  .ftr__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2rem;
    padding-bottom: 2.5rem;
  }
  .ftr__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.015em;
    color: var(--color-text);
    text-decoration: none;
  }
  .ftr__logo:hover span { color: var(--color-accent); }
  .ftr__tagline {
    margin: 0.6rem 0 0;
    max-width: 34ch;
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.55;
  }
  .ftr__heading {
    margin: 0 0 0.7rem;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
  }
  .ftr__col { display: flex; flex-direction: column; }
  .ftr__col a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .ftr__col a:hover { color: var(--color-accent); text-decoration: underline; }

  .ftr__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.85rem;
  }
  .ftr__bottom p { margin: 0; }
  .ftr__legal { display: flex; gap: 1.25rem; }
  .ftr__legal a { display: inline-flex; align-items: center; min-height: 32px; color: var(--color-text-muted); text-decoration: none; }
  .ftr__legal a:hover { color: var(--color-accent); text-decoration: underline; }
  .ftr__disclosure {
    margin: 1rem auto 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-text-faint);
  }

  @media (max-width: 780px) {
    .ftr__grid { grid-template-columns: 1fr 1fr; gap: 1.8rem 1.5rem; }
    .ftr__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 440px) {
    .ftr__grid { grid-template-columns: 1fr; }
  }
</style>
