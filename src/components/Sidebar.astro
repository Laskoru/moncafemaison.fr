---
import { getCollection } from 'astro:content';
import { siteConfig } from '../siteConfig';

interface Props {
  slug: string;
  product?: { asin: string; title: string } | null;
}
const { slug, product = null } = Astro.props;

const latest = (await getCollection('articles', (a) => !a.data.draft && a.slug !== slug))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const amazonTag = siteConfig.amazon?.tag;
const productUrl = product ? `https://www.amazon.fr/dp/${product.asin}?tag=${amazonTag}` : null;
const productImg = product ? `/products/${product.asin}.jpg` : null;

const freebie = (siteConfig as any).freebie;
const nlUrl = (siteConfig as any).newsletter?.actionUrl || '';
---

<aside class="asb">
  {product && (
    <section class="asb__card asb__pick">
      <p class="asb__label">✦ Notre choix du moment</p>
      <a class="asb__prod" href={productUrl} target="_blank" rel="nofollow sponsored noopener">
        {productImg && <img src={productImg} alt="" onerror="this.style.display='none'" loading="lazy" />}
        <span class="asb__prodtitle">{product.title}</span>
      </a>
      <a class="asb__btn" href={productUrl} target="_blank" rel="nofollow sponsored noopener">Voir le prix sur Amazon</a>
    </section>
  )}

  <section class="asb__card asb__nl">
    <p class="asb__label">Newsletter</p>
    <p class="asb__nltext">Reçois nos meilleures astuces par e-mail. Pas de spam, promis.</p>
    <form class="asb__form" action={nlUrl || '#'} method="post" data-live={nlUrl ? '1' : '0'}>
      <input type="email" name="EMAIL" required placeholder="Ton e-mail" aria-label="Ton adresse e-mail" />
      <button type="submit">S’inscrire</button>
    </form>
    <p class="asb__msg" hidden></p>
  </section>

  {freebie && (
    <section class="asb__card asb__free">
      <p class="asb__label">Gratuit</p>
      <h3 class="asb__freetitle">{freebie.title}</h3>
      <p class="asb__freedesc">{freebie.desc}</p>
      <a class="asb__btn asb__btn--ghost" href={freebie.url}>{freebie.cta} →</a>
    </section>
  )}

  {latest.length > 0 && (
    <section class="asb__card">
      <p class="asb__label">À ne pas manquer</p>
      <ul class="asb__list">
        {latest.map((a) => (
          <li><a href={`/articles/${a.slug}/`}>{a.data.title}</a></li>
        ))}
      </ul>
    </section>
  )}
</aside>

<script is:inline>
  (function () {
    var f = document.querySelector('.asb__form');
    if (!f) return;
    if (f.getAttribute('data-live') === '0') {
      f.addEventListener('submit', function (e) {
        e.preventDefault();
        var m = f.parentElement.querySelector('.asb__msg');
        if (m) { m.textContent = 'Merci ! L’inscription sera bientôt active 🌱'; m.hidden = false; }
        f.reset();
      });
    }
  })();
</script>

<style>
  .asb {
    position: sticky;
    top: 5.5rem;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    font-size: 0.95rem;
  }
  .asb__card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.15rem 1.25rem;
    box-shadow: var(--shadow-sm);
  }
  .asb__label {
    margin: 0 0 0.7rem;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  /* Notre choix */
  .asb__prod { display: flex; gap: 0.8rem; align-items: center; text-decoration: none; color: var(--color-text); }
  .asb__prod img { width: 62px; height: 62px; object-fit: contain; border-radius: var(--radius-sm); background: #fff; flex: 0 0 auto; }
  .asb__prodtitle { font-family: var(--font-display); font-weight: 600; font-size: 0.92rem; line-height: 1.25; }
  .asb__btn {
    display: block; text-align: center; margin-top: 0.9rem;
    background: var(--color-accent); color: #fff; font-weight: 700; font-size: 0.9rem;
    text-decoration: none; padding: 0.65rem 1rem; border-radius: 100px;
    transition: filter 0.15s ease;
  }
  .asb__btn:hover { filter: brightness(1.06); text-decoration: none; }
  .asb__btn--ghost { background: transparent; color: var(--color-accent); border: 1px solid var(--color-border); margin-top: 0.7rem; }
  .asb__btn--ghost:hover { border-color: var(--color-accent); }

  /* Newsletter */
  .asb__nltext { margin: 0 0 0.8rem; color: var(--color-text-muted); font-size: 0.88rem; }
  .asb__form { display: flex; flex-direction: column; gap: 0.5rem; }
  .asb__form input {
    font: inherit; font-size: 0.9rem; padding: 0.6rem 0.75rem;
    border-radius: var(--radius); border: 1px solid var(--color-border);
    background: var(--color-bg); color: var(--color-text);
  }
  .asb__form input:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 1px; }
  .asb__form button {
    font: inherit; font-weight: 700; font-size: 0.9rem; cursor: pointer;
    background: var(--color-accent); color: #fff; border: 0;
    padding: 0.6rem 1rem; border-radius: 100px; transition: filter 0.15s ease;
  }
  .asb__form button:hover { filter: brightness(1.06); }
  .asb__msg { margin: 0.6rem 0 0; font-size: 0.85rem; color: var(--color-signal); font-weight: 600; }

  /* Gratuit */
  .asb__freetitle { font-family: var(--font-display); font-size: 1.05rem; margin: 0 0 0.3rem; }
  .asb__freedesc { margin: 0; color: var(--color-text-muted); font-size: 0.88rem; }

  /* À ne pas manquer */
  .asb__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.7rem; }
  .asb__list li { border-top: 1px solid var(--color-border); padding-top: 0.7rem; }
  .asb__list li:first-child { border-top: 0; padding-top: 0; }
  .asb__list a { color: var(--color-text); text-decoration: none; font-family: var(--font-display); font-weight: 600; font-size: 0.92rem; line-height: 1.3; }
  .asb__list a:hover { color: var(--color-accent); }

  @media (max-width: 960px) {
    .asb { position: static; }
  }
</style>
