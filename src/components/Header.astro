---
import { siteConfig } from '../siteConfig';
import { categories } from '../categories';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const links = [
  ...categories.map((c) => ({ href: `/categorie/${c.slug}/`, label: c.short })),
  { href: '/guides/', label: 'Guides' },
  { href: '/outils/', label: 'Outils' },
];
const more = [
  { href: '/articles/', label: 'Tous les comparatifs' },
  { href: '/methodes-cafe/', label: 'Méthodes de café' },
  { href: '/lexique/', label: 'Lexique' },
  { href: '/a-propos/', label: 'À propos' },
];
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="hdr" id="site-header">
  <div class="wide hdr__in">
    <a href="/" class="hdr__logo" aria-label={`${siteConfig.name} — accueil`}>
      <Logo size={32} />
      <span class="hdr__name">{siteConfig.name}</span>
    </a>

    <nav class="hdr__nav" id="site-nav" aria-label="Navigation principale">
      <ul class="hdr__list">
        {links.map((l) => (
          <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <ul class="hdr__list hdr__list--more">
        {more.map((l) => (
          <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <button type="button" id="nav-toggle" class="hdr__toggle" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="site-nav">
      <span class="hdr__toggle-open"><Icon name="menu" size={22} /></span>
      <span class="hdr__toggle-close"><Icon name="close" size={22} /></span>
    </button>
  </div>
</header>

<script is:inline>
  (function () {
    var toggle = document.getElementById('nav-toggle');
    var nav = document.getElementById('site-nav');
    var header = document.getElementById('site-header');
    if (!toggle || !nav) return;
    function setOpen(open) {
      nav.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    }
    toggle.addEventListener('click', function () { setOpen(!nav.classList.contains('is-open')); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) { setOpen(false); toggle.focus(); }
    });
    document.addEventListener('click', function (e) {
      if (nav.classList.contains('is-open') && !header.contains(e.target)) setOpen(false);
    });
  })();
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .hdr__in {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    height: var(--header-h);
  }
  .hdr__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    color: var(--color-text);
    text-decoration: none;
    justify-self: start;
  }
  .hdr__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.015em;
    white-space: nowrap;
    transition: color 0.15s ease;
  }
  .hdr__logo:hover .hdr__name { color: var(--color-accent); }

  .hdr__list { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.15rem; }
  .hdr__list--more { display: none; }
  .hdr__list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.75rem;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    border-top: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .hdr__list a:hover { color: var(--color-accent); }
  .hdr__list a[aria-current='page'] { border-bottom-color: var(--color-accent); }

  .hdr__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    justify-self: end;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }
  .hdr__toggle-open, .hdr__toggle-close { display: inline-flex; }
  .hdr__toggle-close, .hdr__toggle[aria-expanded='true'] .hdr__toggle-open { display: none; }
  .hdr__toggle[aria-expanded='true'] .hdr__toggle-close { display: inline-flex; }

  @media (max-width: 900px) {
    .hdr__in { grid-template-columns: 1fr auto; }
    .hdr__toggle { display: inline-flex; }
    .hdr__nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: 0.5rem 1rem 1rem;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-lift);
      max-height: calc(100vh - var(--header-h));
      overflow-y: auto;
    }
    .hdr__nav.is-open { display: block; }
    .hdr__list { flex-direction: column; gap: 0; }
    .hdr__list--more { display: flex; margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px solid var(--color-border); }
    .hdr__list--more a { font-weight: 500; color: var(--color-text-muted); }
    .hdr__list a {
      width: 100%;
      min-height: 48px;
      padding: 0 0.5rem;
      font-size: 1.05rem;
      border: 0;
      border-bottom: 1px solid var(--color-border);
    }
    .hdr__list li:last-child a { border-bottom: 0; }
    .hdr__list a[aria-current='page'] { color: var(--color-accent); }
  }
</style>
