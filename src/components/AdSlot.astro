---
// Emplacement publicitaire réutilisable.
// Tant qu'AdSense n'est pas activé dans siteConfig, l'emplacement
// reste invisible (pas de layout shift, pas de bloc vide moche).
import { siteConfig } from '../siteConfig';

interface Props {
  slot: string; // identifiant du bloc AdSense, créé depuis ton compte AdSense
  format?: 'auto' | 'fluid';
}

const { slot, format = 'auto' } = Astro.props;
const { enabled, clientId } = siteConfig.adsense;
---

{enabled && (
  <div class="ad-slot">
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={clientId}
      data-ad-slot={slot}
      data-ad-format={format}
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      // Attend que le script AdSense soit effectivement chargé (post-consentement)
      // avant de pousser cet emplacement.
      document.addEventListener('cookie-consent-accepted', function () {
        var tries = 0;
        var i = setInterval(function () {
          tries++;
          if (window.adsbygoogle) {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
            clearInterval(i);
          } else if (tries > 50) {
            clearInterval(i);
          }
        }, 100);
      }, { once: true });
    </script>
  </div>
)}

<style>
  .ad-slot {
    margin: 2rem 0;
    min-height: 1px;
  }
</style>
