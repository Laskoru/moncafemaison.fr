---
import Icon from './Icon.astro';

interface Item { label: string; href?: string }

interface Props {
  items: Item[];
}

const { items } = Astro.props;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.site ?? Astro.url.origin).toString() } : {}),
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<nav class="breadcrumbs" aria-label="Fil d'Ariane">
  <ol>
    {items.map((item, i) => (
      <li>
        {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        {i < items.length - 1 && <span class="breadcrumbs__sep"><Icon name="chevron-right" size={14} /></span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs { margin-bottom: 0.6rem; }
  .breadcrumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.85rem;
  }
  .breadcrumbs li { display: inline-flex; align-items: center; gap: 0.1rem; min-width: 0; }
  .breadcrumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .breadcrumbs a:hover { color: var(--color-accent); text-decoration: underline; }
  .breadcrumbs span[aria-current] {
    color: var(--color-text-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 48ch;
  }
  .breadcrumbs__sep { display: inline-flex; color: var(--color-border-strong); }
</style>
