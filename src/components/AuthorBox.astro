---
// Encart auteur en bas d'article. Signal de confiance (E-E-A-T) : un auteur
// identifié, une bio HONNÊTE (aucun faux diplôme), et des liens vers la page
// auteur, la méthode et le contact.
import { siteConfig } from '../siteConfig';
import Icon from './Icon.astro';
const author = (Astro.props as { author?: string }).author || siteConfig.author;
const BIO = `Je fais mon café à la maison depuis des années, et j'ai lancé ce site parce que le matériel café est un vrai labyrinthe (espresso, moulin, filtre…) où l'on paie souvent trop cher pour le mauvais appareil. Chaque comparatif part d'un <strong>usage réel</strong> et de critères concrets, pas de la liste des best-sellers. Le site est <strong>indépendant</strong> : mes liens Amazon sont affiliés (une petite commission si tu achètes, sans surcoût pour toi), et quand un produit a des défauts, je le dis.`;
const initials = author
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<aside class="authorbox" aria-label="À propos de l'auteur">
  <div class="authorbox__avatar" aria-hidden="true">{initials}</div>
  <div class="authorbox__body">
    <p class="authorbox__name">
      <a href="/auteur/">{author}</a>
      <span class="meta">Passionné de café et fondateur du site</span>
    </p>
    <p class="authorbox__text" set:html={BIO}></p>
    <p class="authorbox__links">
      <a href="/auteur/">En savoir plus sur l'auteur <Icon name="arrow-right" size={15} /></a>
      <a href="/a-propos/">Notre méthode</a>
      <a href="/contact/">Signaler une erreur</a>
    </p>
  </div>
</aside>

<style>
  .authorbox {
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
    margin: 2.8rem 0 0;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .authorbox__avatar {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-ink);
    color: var(--color-accent-on-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: 0.02em;
  }
  .authorbox__name { margin: 0 0 0.5rem; display: flex; flex-direction: column; line-height: 1.3; }
  .authorbox__name a { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; color: var(--color-text); text-decoration: none; }
  .authorbox__name a:hover { color: var(--color-accent); }
  .authorbox__text { margin: 0 0 0.8rem; font-size: 0.98rem; line-height: 1.6; color: var(--color-text-muted); }
  .authorbox__text :global(strong) { color: var(--color-text); }
  .authorbox__links { margin: 0; display: flex; flex-wrap: wrap; gap: 0.2rem 1.4rem; font-family: var(--font-ui); font-weight: 600; font-size: 0.9rem; }
  .authorbox__links a { display: inline-flex; align-items: center; gap: 0.3em; min-height: 32px; text-decoration: none; }
  .authorbox__links a:hover { text-decoration: underline; }
  @media (max-width: 560px) { .authorbox { gap: 0.9rem; } .authorbox__avatar { width: 46px; height: 46px; font-size: 1rem; } }
</style>
