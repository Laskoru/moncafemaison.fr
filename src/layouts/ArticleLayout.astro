---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { coverSrcSet } from '../lib/covers';
import AmazonProduct from '../components/AmazonProduct.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ShareButtons from '../components/ShareButtons.astro';
import AuthorBox from '../components/AuthorBox.astro';
import SelectionMethod from '../components/SelectionMethod.astro';
import { siteConfig } from '../siteConfig';
import { categories, type CategorySlug } from '../categories';
import { isAvailable, searchUrl } from '../lib/availability';

interface Heading { depth: number; slug: string; text: string }
interface FaqItem { question: string; answer: string }
interface Comparison { columns: string[]; rows: string[][] }
interface Source { label: string; url: string }

interface Props {
  topPick?: { name: string; blurb?: string; url: string; ctaLabel?: string };
  hasAmazonLinks?: boolean;
  slug: string;
  title: string;
  seoTitle?: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  coverImage?: string;
  coverAlt?: string;
  category: CategorySlug;
  products?: { asin: string; title: string; image?: string; blurb?: string; pros?: string[]; cons?: string[]; award?: string; search?: string }[];
  headings?: Heading[];
  readingMinutes?: number;
  faq?: FaqItem[];
  comparison?: Comparison;
  sources?: Source[];
}

const {
  slug,
  title,
  seoTitle,
  description,
  pubDate,
  updatedDate,
  author,
  coverImage,
  coverAlt,
  category,
  keywords = [],
  products = [],
  headings = [],
  readingMinutes,
  faq = [],
  comparison,
  sources = [],
  topPick,
  hasAmazonLinks = false,
} = Astro.props;
const hasProducts = siteConfig.amazon.enabled && products.length > 0;
// Mention « liens affiliés » : obligatoire dès qu'il y a un lien Amazon dans la
// page, qu'il vienne d'une carte produit, du « Notre choix » ou du corps du texte.
const hasAffiliateLinks = hasProducts || Boolean(topPick) || hasAmazonLinks;

// Un produit en rupture bascule vers une recherche (voir AmazonProduct), mais
// deux effets de bord restent à corriger explicitement :
//  1. le badge « Notre choix » ne doit jamais tomber sur un produit qu'on ne
//     peut plus acheter — il suit le premier produit RÉELLEMENT disponible ;
//  2. le tableau comparatif compare des caractéristiques qui restent vraies
//     même si un modèle n'est plus en vente, mais il faut le dire : chaque
//     colonne dont le produit associé est épuisé est marquée, avec une note
//     sous le tableau plutôt qu'un silence trompeur.
const productsAvailability = products.map((p) => isAvailable(p.asin));
const featuredIndex = productsAvailability.findIndex(Boolean);
const someProductUnavailable = productsAvailability.some((a) => !a);
// Convention d'écriture du contenu : la colonne N+1 du tableau correspond au
// produit N (colonne 0 = « Critère »).
const comparisonColumnUnavailable = comparison?.columns.map((_, i) => i > 0 && productsAvailability[i - 1] === false);

// Format « guide + recherche + un choix » : après les critères de l'article,
// on propose une recherche Amazon sur le sujet (toujours valide, ne meurt
// jamais) avant de présenter LE produit vérifié en fin d'article.
const searchTopic = keywords[0];
const midArticleSearchUrl = searchTopic ? searchUrl(searchTopic) : null;

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const categoryInfo = categories.find((c) => c.slug === category);

const relatedArticles = (
  await getCollection('articles', (a) => !a.data.draft && a.data.category === category && a.slug !== slug)
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const dateFormatter = new Intl.DateTimeFormat(siteConfig.locale.replace('_', '-'), {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const siteUrl = Astro.site?.origin ?? Astro.url.origin;
const shareUrl = new URL(Astro.url.pathname, siteUrl).toString();
// og:image et l'image du schéma DOIVENT être des URLs absolues (réseaux sociaux
// et Google ignorent les chemins relatifs).
const coverImageAbs = coverImage ? new URL(coverImage, siteUrl).toString() : undefined;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', '@id': `${siteUrl}/auteur/#person`, name: author ?? siteConfig.author, url: new URL('/auteur/', siteUrl).toString() },
  publisher: { '@type': 'Organization', name: siteConfig.name, '@id': `${siteUrl}/#organization` },
  ...(coverImageAbs ? { image: coverImageAbs } : {}),
  ...(sources.length > 0 ? { citation: sources.map((s) => ({ '@type': 'CreativeWork', name: s.label, url: s.url })) } : {}),
  mainEntityOfPage: new URL(Astro.url.pathname, siteUrl).toString(),
};

const faqSchema = faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;

const breadcrumbItems = [
  { label: 'Accueil', href: '/' },
  ...(categoryInfo ? [{ label: categoryInfo.label, href: `/categorie/${categoryInfo.slug}/` }] : []),
  { label: title },
];

// Le JSON-LD BreadcrumbList est émis par le composant <Breadcrumbs /> — ne pas le dupliquer ici.

const jsonLdArticle = [articleSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout
  title={seoTitle ?? title}
  description={description}
  ogImage={coverImageAbs}
  ogType="article"
  jsonLd={jsonLdArticle}
  article={{ publishedTime: pubDate.toISOString(), modifiedTime: (updatedDate ?? pubDate).toISOString(), author: author ?? siteConfig.author, section: categoryInfo?.label, tags: keywords }}
>
  <article class="container">
    <Breadcrumbs items={breadcrumbItems} />

    <header class="article-header">
      <p class="eyebrow">
        {dateFormatter.format(pubDate)}
        {readingMinutes && <> · {readingMinutes} min de lecture</>}
      </p>
      <h1>{title}</h1>
      <p class="article-meta">
        {author ?? siteConfig.author}
        {updatedDate && <> · mis à jour le {dateFormatter.format(updatedDate)}</>}
      </p>
    </header>

    {coverImage && (
      <img
        src={coverImage}
        srcset={coverSrcSet(coverImage)}
        sizes="(max-width: 760px) 100vw, 680px"
        alt={coverAlt ?? ''}
        class="article-cover"
        width="1600"
        height="800"
        fetchpriority="high"
      />
    )}

    {hasAffiliateLinks && <AffiliateDisclosure />}

    {tocHeadings.length > 1 && (
      <nav class="toc" aria-label="Sommaire">
        <p class="toc__title">Sommaire</p>
        <ol>
          {tocHeadings.map((h) => (
            <li data-depth={h.depth}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </nav>
    )}

    {topPick && (
      <aside class="top-pick" aria-label="Notre choix">
        <p class="top-pick__label"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="9" r="6"/><path d="m8.5 14.5-1.5 7 5-2.5 5 2.5-1.5-7"/></svg> Notre choix</p>
        <div class="top-pick__body">
          <div class="top-pick__text">
            <p class="top-pick__name">{topPick.name}</p>
            {topPick.blurb && <p class="top-pick__blurb">{topPick.blurb}</p>}
          </div>
          <a class="cta-btn" href={topPick.url} target="_blank" rel="nofollow sponsored noopener">
            {topPick.ctaLabel ?? 'Voir le prix sur Amazon'} <span aria-hidden="true">→</span>
          </a>
        </div>
        <p class="top-pick__disc">Lien partenaire — en tant que Partenaire Amazon, nous percevons une commission sur les achats éligibles.</p>
      </aside>
    )}

    <div class="article-body">
      <slot />
    </div>

    {hasAffiliateLinks && midArticleSearchUrl && (
      <div class="article-search-cta">
        <span class="article-search-cta__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
            <path d="M20 20L16.5 16.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </span>
        <div class="article-search-cta__body">
          <p class="article-search-cta__intro">Envie de comparer toi-même les modèles du moment ?</p>
          <p class="article-search-cta__sub">Prix, avis et disponibilité en direct sur Amazon.</p>
        </div>
        <a
          class="btn btn--primary article-search-cta__link"
          href={midArticleSearchUrl}
          target="_blank"
          rel="nofollow sponsored noopener"
        >
          Voir « {searchTopic} » →
        </a>
      </div>
    )}

    {comparison && comparison.rows.length > 0 && (
      <div class="article-comparison">
        <h2>Comparatif en un coup d'œil</h2>
        <div class="compare-table-wrap">
          <table class="compare-table">
            <thead>
              <tr>
                {comparison.columns.map((col, i) => (
                  <th>
                    {col}
                    {comparisonColumnUnavailable?.[i] && <span class="compare-table__tag">épuisé</span>}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {comparison.rows.map((row) => (
                <tr>{row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>
              ))}
            </tbody>
          </table>
        </div>
        {someProductUnavailable && (
          <p class="compare-table__note">
            <strong>épuisé</strong> : ce modèle n'est plus en vente chez Amazon. Les caractéristiques
            restent indicatives ; le bouton sous le produit propose des équivalents disponibles.
          </p>
        )}
      </div>
    )}

    {sources.length > 0 && (
      <div class="article-sources">
        <h2>Sources &amp; références</h2>
        <p class="article-sources__intro">
          Les informations de cet article s'appuient sur des sources publiques et reconnues.
        </p>
        <ul class="article-sources__list">
          {sources.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>
          ))}
        </ul>
      </div>
    )}

    <ShareButtons url={shareUrl} title={title} image={coverImage} />

    {hasProducts && (
      <SelectionMethod />
      <div class="article-recommendations">
        <h2>{products.length > 1 ? 'Nos recommandations' : 'Notre choix'}</h2>
        {products.map((p, i) => (
          <AmazonProduct asin={p.asin} title={p.title} image={p.image} blurb={p.blurb} search={p.search} pros={p.pros} cons={p.cons} award={p.award} fallbackSearch={keywords[0]} featured={i === featuredIndex} />
        ))}
      </div>
    )}

    {faq.length > 0 && (
      <div class="article-faq">
        <h2>Questions fréquentes</h2>
        {faq.map((f) => (
          <details class="article-faq__item">
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    )}

    <AuthorBox author={author} />

    <aside class="article-tools" aria-label="Outils et guides pratiques">
      <h2>Outils &amp; guides pratiques</h2>
      <div class="article-tools__list">
          <a href="/methodes-cafe/">Méthodes d’extraction →</a>
          <a href="/calculateur-dosage-cafe/">Calculateur de dosage →</a>
          <a href="/lexique/">Lexique du café →</a>
      </div>
    </aside>

    {relatedArticles.length > 0 && (
      <div class="article-related">
        <h2>À lire aussi{categoryInfo && <> — {categoryInfo.label}</>}</h2>
        <div class="article-related__list">
          {relatedArticles.map((a) => <ArticleCard article={a} />)}
        </div>
      </div>
    )}
  </article>
</BaseLayout>

<style>
  .article-header { margin-bottom: 1.5rem; }
  /* Titre lisible sur mobile : ~30 px sur un téléphone au lieu de 46 px (un titre long prenait tout l'écran). */
  .article-header h1 { margin-top: 0.4rem; font-size: clamp(1.9rem, 4.2vw + 0.8rem, 2.9rem); line-height: 1.12; }
  .article-meta {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-top: -0.5rem;
  }
  .article-cover {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 8;
    object-fit: cover;
    margin: 1.5rem 0;
    border-radius: var(--radius-lg);
  }
  /* ---- Corps d'article : lecture agréable ---- */
  .article-body { font-size: 1.07rem; line-height: 1.78; }
  .article-body :global(p) { margin: 0 0 1.25em; }
  .article-body :global(> p:first-of-type) { font-size: 1.2rem; line-height: 1.68; color: var(--color-text); }
  .article-body :global(h2) {
    margin-top: 2.4em; margin-bottom: 0.55em; scroll-margin-top: 5rem;
    font-size: 1.55rem; padding-left: 0.7rem;
    border-left: 4px solid var(--color-accent);
  }
  .article-body :global(h3) { margin-top: 1.8em; scroll-margin-top: 5rem; font-size: 1.2rem; color: var(--color-accent); }
  .article-body :global(a) {
    color: var(--color-accent); text-decoration: underline;
    text-underline-offset: 0.18em; text-decoration-thickness: 1.5px;
  }
  .article-body :global(a:hover) { text-decoration-thickness: 2.5px; }
  .article-body :global(strong) { color: var(--color-text); font-weight: 700; }
  .article-body :global(img) {
    display: block; width: 100%; height: auto; margin: 1.9rem 0;
    border-radius: var(--radius-lg); border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md, 0 18px 44px -16px rgba(0,0,0,.4));
  }
  .article-body :global(ul) { list-style: none; padding-left: 0; margin: 0 0 1.4em; display: flex; flex-direction: column; gap: 0.55em; }
  .article-body :global(ul li) { position: relative; padding-left: 1.6em; }
  .article-body :global(ul li::before) {
    content: ''; position: absolute; left: 0.15em; top: 0.62em;
    width: 0.5em; height: 0.5em; border-radius: 3px; background: var(--color-accent);
  }
  .article-body :global(ol) { padding-left: 1.3em; margin: 0 0 1.4em; display: flex; flex-direction: column; gap: 0.55em; }
  .article-body :global(ol li::marker) { color: var(--color-accent); font-weight: 700; }
  .article-body :global(blockquote) {
    margin: 1.9rem 0; padding: 1.1rem 1.35rem; border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-accent) 9%, var(--color-surface, transparent));
    border: 1px solid color-mix(in srgb, var(--color-accent) 28%, var(--color-border));
    border-left: 4px solid var(--color-accent);
  }
  .article-body :global(blockquote p) { margin: 0 0 0.5em; }
  .article-body :global(blockquote p:last-child) { margin-bottom: 0; }
  .article-body :global(blockquote a) { font-weight: 700; }
  .article-body :global(table) { width: 100%; border-collapse: collapse; margin: 1.7rem 0; font-size: 0.95rem; display: block; overflow-x: auto; }
  .article-body :global(th), .article-body :global(td) { text-align: left; padding: 0.7rem 0.85rem; border-bottom: 1px solid var(--color-border); }
  .article-body :global(th) { color: var(--color-accent); font-family: var(--font-display); white-space: nowrap; }
  .article-body :global(hr) { border: 0; height: 1px; background: var(--color-border); margin: 2.6rem 0; }

  .article-search-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.1rem;
    margin: 2.2rem 0;
    padding: 1.15rem 1.4rem;
    background: var(--color-accent-soft);
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    border-radius: var(--radius-lg);
  }
  .article-search-cta__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-accent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-accent) 20%, transparent);
  }
  .article-search-cta__body { flex: 1 1 220px; min-width: 0; }
  .article-search-cta__intro { margin: 0; color: var(--color-text); font-weight: 600; font-size: 0.98rem; }
  .article-search-cta__sub { margin: 0.2rem 0 0; color: var(--color-text-muted); font-size: 0.85rem; }
  /* Le texte du bouton dépend du mot-clé de l'article (longueur variable) :
     il DOIT pouvoir passer à la ligne, sinon il déborde du bloc — et donc de
     la page — sur mobile. */
  .article-search-cta__link { flex: 0 1 auto; min-width: 0; white-space: normal; text-align: center; }

  @media (max-width: 480px) {
    .article-search-cta__icon { display: none; }
    .article-search-cta__link { width: 100%; }
  }

  .article-faq { margin-top: 3rem; }
  .article-faq__item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    padding: 1rem 1.3rem;
    margin-bottom: 0.8rem;
  }
  .article-faq__item summary {
    cursor: pointer;
    font-weight: 600;
    font-family: var(--font-display);
  }
  .article-faq__item p { margin: 0.7rem 0 0; color: var(--color-text-muted); }

  .article-related { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--color-border); }
  .article-related__list { display: flex; flex-direction: column; gap: 1.1rem; }

  /* ---- Sources & références (E-E-A-T) ---- */
  .article-sources { margin-top: 2.6rem; padding: 1.3rem 1.5rem; border-radius: var(--radius-lg); background: var(--color-surface); border: 1px solid var(--color-border); }
  .article-sources h2 { margin: 0 0 0.4rem; font-size: 1.15rem; }
  .article-sources__intro { margin: 0 0 0.9rem; font-size: 0.9rem; color: var(--color-text-muted); }
  .article-sources__list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.55rem; }
  .article-sources__list li { position: relative; padding-left: 1.4em; font-size: 0.95rem; }
  .article-sources__list li::before { content: '↗'; position: absolute; left: 0; top: 0; color: var(--color-accent); font-weight: 700; }
  .article-sources__list a { color: var(--color-accent); text-decoration: none; font-weight: 600; }
  .article-sources__list a:hover { text-decoration: underline; }

  .article-tools { margin-top: 3rem; }
  .article-tools > h2 { font-size: 1.3rem; margin: 0 0 1rem; }
  .article-tools__list { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .article-tools__list a { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.6rem 1rem; border-radius: 999px; border: 1px solid var(--color-border); background: var(--color-surface); color: var(--color-accent); text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: border-color .15s, background .15s; }
  .article-tools__list a:hover { border-color: var(--color-accent); background: var(--color-bg-soft); }

  /* ---- Carte « Notre choix » (conversion) ---- */
  .top-pick {
    margin: 1.6rem 0;
    padding: 1.2rem 1.4rem 0.9rem;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface, transparent));
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, var(--color-border));
    box-shadow: 0 12px 30px -18px color-mix(in srgb, var(--color-accent) 60%, transparent);
  }
  .top-pick__label { display: flex; align-items: center; gap: .35rem; margin: 0 0 0.5rem; font-family: var(--font-display); font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent); }
  .top-pick__body { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; }
  .top-pick__text { flex: 1 1 220px; }
  .top-pick__name { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; color: var(--color-text); line-height: 1.25; }
  .top-pick__blurb { margin: 0.35rem 0 0; color: var(--color-text-muted); font-size: 0.96rem; line-height: 1.4; }
  .top-pick__disc { margin: 0.85rem 0 0; font-size: 0.75rem; color: var(--color-text-faint); }
  .cta-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; max-width: 100%; text-align: center;
    padding: 0.8rem 1.4rem; border-radius: 999px;
    background: var(--color-accent); color: #fff; font-weight: 700; font-size: 1rem;
    text-decoration: none; border: 0; cursor: pointer;
    box-shadow: 0 10px 22px -10px color-mix(in srgb, var(--color-accent) 75%, transparent);
    transition: transform .12s ease, filter .12s ease;
  }
  .cta-btn:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .cta-btn span { transition: transform .12s ease; }
  .cta-btn:hover span { transform: translateX(3px); }
</style>
