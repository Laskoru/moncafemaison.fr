---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { coverSrcSet } from '../lib/covers';
import AmazonProduct from '../components/AmazonProduct.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ShareButtons from '../components/ShareButtons.astro';
import AuthorBox from '../components/AuthorBox.astro';
import SelectionMethod from '../components/SelectionMethod.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../siteConfig';
import { categories, type CategorySlug } from '../categories';
import { isAvailable, searchUrl } from '../lib/availability';

interface Heading { depth: number; slug: string; text: string }
interface FaqItem { question: string; answer: string }
interface Comparison { columns: string[]; rows: string[][] }
interface Source { label: string; url: string }

interface Props {
  topPick?: { name: string; blurb?: string; url: string; ctaLabel?: string };
  hasAmazonLinks?: boolean;
  slug: string;
  title: string;
  seoTitle?: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  coverImage?: string;
  coverAlt?: string;
  category: CategorySlug;
  keywords?: string[];
  products?: { asin: string; title: string; image?: string; blurb?: string; pros?: string[]; cons?: string[]; award?: string; search?: string }[];
  headings?: Heading[];
  readingMinutes?: number;
  faq?: FaqItem[];
  comparison?: Comparison;
  sources?: Source[];
}

const {
  slug,
  title,
  seoTitle,
  description,
  pubDate,
  updatedDate,
  author,
  coverImage,
  coverAlt,
  category,
  keywords = [],
  products = [],
  headings = [],
  readingMinutes,
  faq = [],
  comparison,
  sources = [],
  topPick,
  hasAmazonLinks = false,
} = Astro.props;
const hasProducts = siteConfig.amazon.enabled && products.length > 0;
// Mention « liens affiliés » : obligatoire dès qu'il y a un lien Amazon dans la
// page, qu'il vienne d'une carte produit, du « Notre choix » ou du corps du texte.
const hasAffiliateLinks = hasProducts || Boolean(topPick) || hasAmazonLinks;

// Un produit en rupture bascule vers une recherche (voir AmazonProduct), mais
// deux effets de bord restent à corriger explicitement :
//  1. le badge « Notre choix » ne doit jamais tomber sur un produit qu'on ne
//     peut plus acheter — il suit le premier produit RÉELLEMENT disponible ;
//  2. le tableau comparatif compare des caractéristiques qui restent vraies
//     même si un modèle n'est plus en vente, mais il faut le dire : chaque
//     colonne dont le produit associé est épuisé est marquée, avec une note
//     sous le tableau plutôt qu'un silence trompeur.
const productsAvailability = products.map((p) => isAvailable(p.asin));
const featuredIndex = productsAvailability.findIndex(Boolean);
const someProductUnavailable = productsAvailability.some((a) => !a);
// Convention d'écriture du contenu : la colonne N+1 du tableau correspond au
// produit N (colonne 0 = « Critère »).
const comparisonColumnUnavailable = comparison?.columns.map((_, i) => i > 0 && productsAvailability[i - 1] === false);

// Format « guide + recherche + un choix » : après les critères de l'article,
// on propose une recherche Amazon sur le sujet (toujours valide, ne meurt
// jamais) avant de présenter LE produit vérifié en fin d'article.
const searchTopic = keywords[0];
const midArticleSearchUrl = searchTopic ? searchUrl(searchTopic) : null;

// Bandeau de sommaire collant : les chapitres (h2) uniquement, lisibles d'un coup d'œil.
const tocHeadings = headings.filter((h) => h.depth === 2);
const categoryInfo = categories.find((c) => c.slug === category);

const relatedArticles = (
  await getCollection('articles', (a) => !a.data.draft && a.data.category === category && a.slug !== slug)
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const dateFormatter = new Intl.DateTimeFormat(siteConfig.locale.replace('_', '-'), {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const siteUrl = Astro.site?.origin ?? Astro.url.origin;
const shareUrl = new URL(Astro.url.pathname, siteUrl).toString();
// og:image et l'image du schéma DOIVENT être des URLs absolues (réseaux sociaux
// et Google ignorent les chemins relatifs).
const coverImageAbs = coverImage ? new URL(coverImage, siteUrl).toString() : undefined;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', '@id': `${siteUrl}/auteur/#person`, name: author ?? siteConfig.author, url: new URL('/auteur/', siteUrl).toString() },
  publisher: { '@type': 'Organization', name: siteConfig.name, '@id': `${siteUrl}/#organization` },
  ...(coverImageAbs ? { image: coverImageAbs } : {}),
  ...(sources.length > 0 ? { citation: sources.map((s) => ({ '@type': 'CreativeWork', name: s.label, url: s.url })) } : {}),
  mainEntityOfPage: new URL(Astro.url.pathname, siteUrl).toString(),
};

const faqSchema = faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;

const breadcrumbItems = [
  { label: 'Accueil', href: '/' },
  ...(categoryInfo ? [{ label: categoryInfo.label, href: `/categorie/${categoryInfo.slug}/` }] : []),
  { label: title },
];

// Le JSON-LD BreadcrumbList est émis par le composant <Breadcrumbs /> — ne pas le dupliquer ici.

const jsonLdArticle = [articleSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout
  title={seoTitle ?? title}
  description={description}
  ogImage={coverImageAbs}
  ogType="article"
  jsonLd={jsonLdArticle}
  article={{ publishedTime: pubDate.toISOString(), modifiedTime: (updatedDate ?? pubDate).toISOString(), author: author ?? siteConfig.author, section: categoryInfo?.label, tags: keywords }}
>
  <article class="art">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />

      <header class="art__head">
        <h1 class="art__title">{title}</h1>
        <p class="meta meta-row art__meta">
          <span>Par <a href="/auteur/">{author ?? siteConfig.author}</a></span>
          <time datetime={pubDate.toISOString().slice(0, 10)}>{dateFormatter.format(pubDate)}</time>
          {updatedDate && <span>Mis à jour le <time datetime={updatedDate.toISOString().slice(0, 10)}>{dateFormatter.format(updatedDate)}</time></span>}
          {readingMinutes && <span>{readingMinutes} min de lecture</span>}
        </p>
      </header>

      {coverImage && (
        <figure class="art__cover">
          <img
            src={coverImage}
            srcset={coverSrcSet(coverImage)}
            sizes="(max-width: 760px) 100vw, 680px"
            alt={coverAlt ?? ''}
            width="1600"
            height="900"
            fetchpriority="high"
          />
        </figure>
      )}

      {hasAffiliateLinks && <AffiliateDisclosure />}
    </div>

    {tocHeadings.length > 1 && (
      <nav class="toc" id="toc" aria-label="Sommaire">
        <div class="container toc__in">
          <span class="toc__label"><Icon name="list" size={16} /> Sommaire</span>
          <ol class="toc__list">
            {tocHeadings.map((h) => (
              <li><a href={`#${h.slug}`} title={h.text}>{h.text}</a></li>
            ))}
          </ol>
        </div>
      </nav>
    )}

    <div class="container">
      {topPick && (
        <aside class="pick" aria-label="Notre choix">
          <div class="pick__main">
            <p class="pick__name">{topPick.name}</p>
            {topPick.blurb && <p class="pick__blurb">{topPick.blurb}</p>}
          </div>
          <div class="pick__side">
            <p class="pick__flag"><Icon name="award" size={15} /> Notre choix</p>
            <a class="btn btn--primary pick__cta" href={topPick.url} target="_blank" rel="nofollow sponsored noopener">
              {topPick.ctaLabel ?? 'Voir le prix sur Amazon'} <Icon name="external" size={16} />
            </a>
            <p class="pick__disc">Lien partenaire : le site perçoit une commission sur les achats éligibles, sans surcoût pour toi.</p>
          </div>
        </aside>
      )}

      <div class="article-body">
        <slot />
      </div>

      {hasAffiliateLinks && midArticleSearchUrl && (
        <div class="art-search">
          <span class="art-search__icon"><Icon name="search" size={20} /></span>
          <div class="art-search__body">
            <p class="art-search__intro">Envie de comparer toi-même les modèles du moment ?</p>
            <p class="art-search__sub">Prix, avis et disponibilité en direct sur Amazon.</p>
          </div>
          <a class="btn btn--outline art-search__link" href={midArticleSearchUrl} target="_blank" rel="nofollow sponsored noopener">
            Voir « {searchTopic} » <Icon name="external" size={16} />
          </a>
        </div>
      )}

      {comparison && comparison.rows.length > 0 && (
        <section class="art-compare">
          <h2>Comparatif en un coup d'œil</h2>
          <div class="table-wrap">
            <table class="table table--stack">
              <thead>
                <tr>
                  {comparison.columns.map((col, i) => (
                    <th scope="col">
                      {col}
                      {comparisonColumnUnavailable?.[i] && <span class="table__tag">épuisé</span>}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {comparison.rows.map((row) => (
                  <tr>{row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td data-label={comparison.columns[i]}>{cell}</td>))}</tr>
                ))}
              </tbody>
            </table>
          </div>
          {someProductUnavailable && (
            <p class="table__note">
              <strong>épuisé</strong> : ce modèle n'est plus en vente chez Amazon. Les caractéristiques
              restent indicatives ; le bouton sous le produit propose des équivalents disponibles.
            </p>
          )}
        </section>
      )}

      {sources.length > 0 && (
        <section class="art-sources">
          <h2>Sources et références</h2>
          <p class="art-sources__intro">
            Les informations de cet article s'appuient sur des sources publiques et reconnues.
          </p>
          <ul class="art-sources__list">
            {sources.map((s) => (
              <li><Icon name="external" size={15} /><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>
            ))}
          </ul>
        </section>
      )}

      <ShareButtons url={shareUrl} title={title} image={coverImage} />

      {hasProducts && (
        <SelectionMethod />
        <section class="art-products">
          <h2>{products.length > 1 ? 'Nos recommandations' : 'Notre choix'}</h2>
          {products.map((p, i) => (
            <AmazonProduct asin={p.asin} title={p.title} image={p.image} blurb={p.blurb} search={p.search} pros={p.pros} cons={p.cons} award={p.award} fallbackSearch={keywords[0]} featured={i === featuredIndex} hideDefaultAward={products.length === 1} />
          ))}
        </section>
      )}

      {faq.length > 0 && (
        <section class="art-faq">
          <h2>Questions fréquentes</h2>
          <div class="art-faq__list">
            {faq.map((f) => (
              <details class="art-faq__item">
                <summary><span>{f.question}</span><Icon name="chevron-down" size={18} /></summary>
                <p>{f.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <AuthorBox author={author} />

      <aside class="art-tools" aria-label="Outils et guides pratiques">
        <h2>Outils et guides pratiques</h2>
        <ul class="art-tools__list">
          <li><a href="/methodes-cafe/"><Icon name="compass" size={18} /> Quelle méthode de café ?</a></li>
          <li><a href="/calculateur-dosage-cafe/"><Icon name="calculator" size={18} /> Calculateur de dosage</a></li>
          <li><a href="/lexique/"><Icon name="book" size={18} /> Lexique du café</a></li>
        </ul>
      </aside>

      {relatedArticles.length > 0 && (
        <section class="art-related">
          <div class="section-head">
            <h2>À lire aussi</h2>
            {categoryInfo && <a class="section-head__link" href={`/categorie/${categoryInfo.slug}/`}>{categoryInfo.label} <Icon name="arrow-right" size={16} /></a>}
          </div>
          <ul class="rows">
            {relatedArticles.map((a) => <li><ArticleCard article={a} variant="row" /></li>)}
          </ul>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<script is:inline>
  // Sommaire collant : chapitre courant souligné, et gardé visible dans la bande.
  (function () {
    var toc = document.getElementById('toc');
    if (!toc || !('IntersectionObserver' in window)) return;
    var links = Array.prototype.slice.call(toc.querySelectorAll('a[href^="#"]'));
    var map = new Map();
    links.forEach(function (a) {
      var target = document.getElementById(decodeURIComponent(a.getAttribute('href').slice(1)));
      if (target) map.set(target, a);
    });
    var spy = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        links.forEach(function (l) { l.removeAttribute('aria-current'); });
        var link = map.get(e.target);
        if (!link) return;
        link.setAttribute('aria-current', 'true');
        link.scrollIntoView({ inline: 'nearest', block: 'nearest', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      });
    }, { rootMargin: '-30% 0px -60% 0px' });
    map.forEach(function (_l, target) { spy.observe(target); });
  })();
</script>

<style>
  .art { padding-top: 1.1rem; }
  .art__head { margin: 0.4rem 0 1.5rem; }
  .art__title { margin: 0 0 0.9rem; font-size: clamp(1.9rem, 1.2rem + 2.4vw, 2.6rem); max-width: 26ch; }
  .art__meta { margin-bottom: 0; }
  .art__meta a { color: var(--color-text); text-decoration: none; font-weight: 600; }
  .art__meta a:hover { color: var(--color-accent); text-decoration: underline; }
  .art__cover { margin: 0 0 1.25rem; }
  .art__cover img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }

  /* ---- Bandeau de sommaire collant ---- */
  .toc {
    position: sticky;
    top: var(--header-h);
    z-index: 30;
    margin: 0.5rem 0 1.75rem;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .toc__in { display: flex; align-items: center; gap: 1rem; min-height: 48px; }
  .toc__label {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    flex: none;
    padding-right: 1rem;
    border-right: 1px solid var(--color-border);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    padding-right: 3rem;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 48px), transparent);
    mask-image: linear-gradient(to right, #000 calc(100% - 48px), transparent);
  }
  .toc__list::-webkit-scrollbar { display: none; }
  /* Chaque chapitre tient dans la bande visible (points de suspension au besoin) :
     le chapitre courant, ramené en vue par le scrollspy, n'est jamais coupé à gauche. */
  .toc__list { flex: 1 1 auto; min-width: 0; }
  .toc__list li { flex: none; max-width: 100%; }
  .toc__list a {
    display: block;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    line-height: 40px;
    padding: 0 0.6rem;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.88rem;
    color: var(--color-text-muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    border-top: 2px solid transparent;
  }
  .toc__list a:hover { color: var(--color-accent); }
  .toc__list a[aria-current='true'] { color: var(--color-text); border-bottom-color: var(--color-accent); }

  /* ---- Fiche « Notre choix » (recommandation par lien de recherche, sans photo) :
         deux colonnes, verdict à gauche, libellé + bouton à droite ---- */
  .pick {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(256px, 40%);
    gap: 1.5rem;
    margin: 0 0 2rem;
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lift);
  }
  .pick__main { min-width: 0; align-self: center; }
  .pick__name { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; line-height: 1.2; color: var(--color-text); }
  .pick__blurb { margin: 0.5rem 0 0; color: var(--color-text-muted); font-size: 1rem; line-height: 1.5; }
  .pick__side { display: flex; flex-direction: column; justify-content: center; gap: 0.7rem; padding-left: 1.5rem; border-left: 1px solid var(--color-border); }
  .pick__flag { margin: 0; display: inline-flex; align-items: center; gap: 0.35em; font-family: var(--font-ui); font-weight: 700; font-size: 0.76rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); }
  .pick__cta { width: 100%; padding-inline: 1em; font-size: 0.95rem; }
  .pick__disc { margin: 0; font-family: var(--font-ui); font-weight: 500; font-size: 0.76rem; line-height: 1.4; color: var(--color-text-faint); }
  @media (max-width: 600px) {
    .pick { grid-template-columns: 1fr; gap: 1rem; padding: 1.25rem; }
    .pick__side { padding: 1rem 0 0; border-left: 0; border-top: 1px solid var(--color-border); }
  }

  /* ---- Corps d'article : colonne de lecture 68ch ---- */
  .article-body { max-width: var(--measure); font-size: 1.0625rem; line-height: 1.72; }
  .article-body :global(p) { margin: 0 0 1.3em; }
  .article-body :global(> p:first-of-type) { font-size: 1.2rem; line-height: 1.6; }
  .article-body :global(h2) {
    margin: 2.4em 0 0.7em;
    padding-top: 1.2em;
    border-top: 1px solid var(--color-border);
    font-size: 1.65rem;
    scroll-margin-top: calc(var(--header-h) + 64px);
  }
  .article-body :global(h3) { margin: 1.8em 0 0.5em; font-size: 1.25rem; scroll-margin-top: calc(var(--header-h) + 64px); }
  .article-body :global(h4) { margin: 1.5em 0 0.4em; font-size: 1.05rem; }
  .article-body :global(a) { text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .article-body :global(a:hover) { text-decoration-thickness: 2px; }
  .article-body :global(strong) { font-weight: 600; color: var(--color-text); }
  .article-body :global(img) {
    width: 100%;
    margin: 1.75rem 0;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }
  .article-body :global(ul), .article-body :global(ol) { margin: 0 0 1.4em; padding-left: 1.4em; display: flex; flex-direction: column; gap: 0.45em; }
  .article-body :global(li::marker) { color: var(--color-accent); }
  .article-body :global(ol li::marker) { font-family: var(--font-ui); font-weight: 600; }
  .article-body :global(blockquote) { margin: 1.8rem 0; font-style: normal; }
  .article-body :global(blockquote p:last-child) { margin-bottom: 0; }
  .article-body :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    margin: 1.7rem 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    border-collapse: collapse;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.92rem;
    line-height: 1.4;
    background: var(--color-surface);
  }
  .article-body :global(th), .article-body :global(td) { text-align: left; padding: 0.7rem 0.85rem; border-bottom: 1px solid var(--color-border); vertical-align: top; }
  .article-body :global(thead th) { font-size: 0.74rem; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: var(--color-text-muted); background: var(--color-bg-soft); white-space: nowrap; }
  .article-body :global(tbody tr:nth-child(even)) { background: #faf6f0; }
  .article-body :global(tbody tr:last-child td), .article-body :global(tbody tr:last-child th) { border-bottom: 0; }
  .article-body :global(hr) { margin: 2.4rem 0; }

  /* ---- Recherche Amazon en milieu de page ---- */
  .art-search {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    margin: 2.2rem 0;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .art-search__icon { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: var(--color-accent-soft); color: var(--color-accent); }
  .art-search__body { flex: 1 1 220px; min-width: 0; }
  .art-search__intro { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; }
  .art-search__sub { margin: 0.15rem 0 0; font-size: 0.92rem; color: var(--color-text-muted); }
  /* Le texte du bouton dépend du mot-clé de l'article : il doit pouvoir passer à la ligne. */
  .art-search__link { flex: 0 1 auto; min-width: 0; white-space: normal; text-align: center; }
  @media (max-width: 480px) { .art-search__icon { display: none; } .art-search__link { width: 100%; } }

  .art-compare h2, .art-sources h2, .art-products h2, .art-faq h2, .art-tools h2 { font-size: 1.55rem; margin: 2.6rem 0 1rem; }
  .art-compare .table-wrap { margin-top: 0.5rem; }

  /* ---- Sources (E-E-A-T) ---- */
  .art-sources__intro { margin: 0 0 0.8rem; font-size: 0.95rem; color: var(--color-text-muted); }
  .art-sources__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .art-sources__list li { display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 0; border-top: 1px solid var(--color-border); font-family: var(--font-ui); font-weight: 500; font-size: 0.95rem; color: var(--color-accent); }
  .art-sources__list li:last-child { border-bottom: 1px solid var(--color-border); }
  .art-sources__list a { text-decoration: none; }
  .art-sources__list a:hover { text-decoration: underline; }

  /* ---- FAQ ---- */
  .art-faq__list { border-top: 1px solid var(--color-border); }
  .art-faq__item { border-bottom: 1px solid var(--color-border); }
  .art-faq__item summary {
    display: flex;
