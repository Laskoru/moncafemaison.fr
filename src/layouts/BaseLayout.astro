---
import { siteConfig } from '../siteConfig';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Page à ne pas indexer (ex. catégorie vide) : noindex + follow. */
  noindex?: boolean;
  /** Métadonnées Open Graph « article » (Rich Pins Pinterest, Facebook, Discover). */
  article?: { publishedTime: string; modifiedTime?: string; author?: string; section?: string; tags?: string[] };
}

const { title, description = siteConfig.description, ogImage, ogType = 'website', jsonLd, noindex = false, article } = Astro.props;
// Meta description : Google coupe vers 160 caractères ; on coupe nous-mêmes en fin de mot plutôt que lui au milieu.
const metaDescription = description.length > 160 ? description.slice(0, 157).replace(/\s+\S*$/, '') + '…' : description;
// Suffixe « | Nom du site » seulement s'il tient : au-delà de ~65 caractères
// Google tronque et le nom disparaîtrait de toute façon (il est affiché à part
// grâce au schéma WebSite). Pas de doublon si le titre contient déjà le nom.
const pageTitle = title.includes(siteConfig.name) || title.length + siteConfig.name.length + 3 > 65
  ? title
  : `${title} | ${siteConfig.name}`;
const { enabled, clientId } = siteConfig.adsense;
const siteUrl = Astro.site?.origin ?? Astro.url.origin;

// Image de partage : la couverture de la page si elle en a une, sinon la carte
// de marque par défaut (garantit une vignette sur TOUS les partages : accueil,
// catégories, pages fixes…). Toujours résolue en URL absolue.
const resolvedOgImage = ogImage ?? new URL('/og-default.jpg', siteUrl).toString();
const logoUrl = new URL('/logo.png', siteUrl).toString();

// Liens officiels du site (profils réseaux) pour le champ sameAs du schéma
// Organization — n'apparaît que si au moins un lien est renseigné.
const sameAs = [siteConfig.social?.pinterest, siteConfig.social?.flipboard, siteConfig.social?.instagram, siteConfig.social?.twitter].filter(Boolean);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: siteConfig.name,
  url: siteUrl,
  description: siteConfig.description,
  logo: logoUrl,
  image: resolvedOgImage,
  ...(sameAs.length ? { sameAs } : {}),
};

// Schéma WebSite : nom du site affiché dans Google, relié à l'organisation.
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: siteConfig.name,
  url: siteUrl,
  inLanguage: siteConfig.lang,
  publisher: { '@id': `${siteUrl}/#organization` },
};

const jsonLdBlocks = [organizationSchema, websiteSchema, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!DOCTYPE html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fbf8f3" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- PNG multiples de 48 px : format attendu par Google pour afficher le favicon dans les résultats -->
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={Astro.url} />
    <!-- Google Discover : autorise les grandes vignettes (indispensable pour apparaître dans le flux Discover) -->
    <meta name="robots" content={noindex ? 'noindex, follow, max-image-preview:large' : 'max-image-preview:large'} />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.name} href="/rss.xml" />
    {siteConfig.googleSiteVerification && (
      <meta name="google-site-verification" content={siteConfig.googleSiteVerification} />
    )}
    {siteConfig.pinterestVerification && (
      <meta name="p:domain_verify" content={siteConfig.pinterestVerification} />
    )}
    {siteConfig.gaId && (
      <script define:vars={{ gaId: siteConfig.gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        document.addEventListener('cookie-consent-accepted', function () {
          if (window.__gaLoaded) return;
          window.__gaLoaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
          gtag('js', new Date());
          gtag('config', gaId);
          document.addEventListener('click', function (e) {
            var a = e.target && e.target.closest ? e.target.closest('a[href*="amazon."]') : null;
            if (!a) return;
            gtag('event', 'amazon_click', { link_url: a.href, link_text: (a.textContent || '').trim().slice(0, 100), page_path: location.pathname });
          }, true);
        }, { once: true });
      </script>
    )}
    <!-- Polices auto-hébergées : voir src/styles/fonts.css (préchargement titre + corps, latin) -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/bricolage-grotesque-normal-500-800-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/source-serif-4-normal-400-latin.woff2" crossorigin />

    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:alt" content={pageTitle} />
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
        {article.author && <meta property="article:author" content={article.author} />}
        {article.section && <meta property="article:section" content={article.section} />}
        {(article.tags ?? []).map((t) => <meta property="article:tag" content={t} />)}
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <style set:html={`:root { --color-accent: ${siteConfig.accentColor}; }`}></style>

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    {enabled && (
      <script
        is:inline
        define:vars={{ clientId }}
      >
        // Le script AdSense ne se charge qu'après acceptation des cookies (RGPD)
        document.addEventListener('cookie-consent-accepted', function loadAds() {
          if (window.__adsenseLoaded) return;
          window.__adsenseLoaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + clientId;
          s.crossOrigin = 'anonymous';
          document.head.appendChild(s);
        }, { once: true });
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {(siteConfig.gaId || siteConfig.adsense.enabled) && <CookieConsent />}
  </body>
</html>
