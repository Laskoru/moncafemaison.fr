---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { siteConfig } from '../siteConfig';

const personSameAs = [siteConfig.social?.pinterest, siteConfig.social?.flipboard].filter(Boolean);
const authorName = siteConfig.author;
const siteUrl = Astro.site?.origin ?? Astro.url.origin;

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const recent = allArticles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const initials = authorName.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    '@id': `${siteUrl}/auteur/#person`,
    name: authorName,
    url: `${siteUrl}/auteur/`,
    ...(personSameAs.length ? { sameAs: personSameAs } : {}),
    jobTitle: 'Passionné de café & fondateur',
    worksFor: { '@id': `${siteUrl}/#organization` },
    knowsAbout: ['café de spécialité', 'machines à café', 'moulins à café', "méthodes d'extraction du café"],
  },
};
---

<BaseLayout
  title={`${authorName} — auteur`}
  description={`${authorName}, la personne derrière ${siteConfig.name}. Qui écrit les guides et comparatifs, avec quelle méthode et en toute indépendance.`}
  jsonLd={jsonLd}
>
  <header class="author-head">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Accueil', href: '/' }, { label: 'L’auteur' }]} />
      <div class="author-head__row">
        <div class="author-head__avatar" aria-hidden="true">{initials}</div>
        <div>
          <h1 class="author-head__name">{authorName}</h1>
          <p class="meta author-head__role">Passionné de café et fondateur de {siteConfig.name} · {allArticles.length} articles publiés</p>
        </div>
      </div>
    </div>
  </header>

  <section class="container author">
    <div class="author__bio">
      <p set:html={`Bonjour ! Je suis Hugo, la personne derrière ${siteConfig.name}. J'ai lancé ce site parce que réussir un bon café chez soi tient à peu de choses (le bon moulin, la bonne méthode) mais que le marketing du café rend le choix du matériel inutilement compliqué.`}></p>
      <p set:html={`Mon approche est concrète : je pars de l'<strong>usage réel</strong> (quel café tu bois, quel budget, combien de temps le matin) et de <strong>critères mesurables</strong> plutôt que de fiches marketing. J'explique le <strong>pourquoi</strong> (mouture, pression, température) pour que tu choisisses en connaissance de cause.`}></p>
      <p set:html={`Le site est <strong>indépendant</strong> : aucune marque ne paie pour figurer ou être mieux classée. ${siteConfig.name} se finance uniquement via l'affiliation Amazon : si tu achètes après avoir cliqué sur un lien, je touche une petite commission, <strong>sans aucun surcoût pour toi</strong>. Quand un produit a des défauts, je le dis.`}></p>
      <p class="author__links">
        <a class="btn btn--outline" href="/a-propos/">Notre méthode en détail</a>
        <a class="btn btn--outline" href="/contact/">Me contacter</a>
      </p>
    </div>

    <h2 class="author__section">Mes derniers articles</h2>
    <ul class="rows">
      {recent.map((article) => <li><ArticleCard article={article} variant="row" /></li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  .author-head { border-bottom: 1px solid var(--color-border); }
  .author-head .container { padding-top: 1.1rem; padding-bottom: 1.8rem; }
  .author-head__row { display: flex; align-items: center; gap: 1.25rem; margin-top: 0.4rem; }
  .author-head__avatar { flex-shrink: 0; width: 76px; height: 76px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: var(--color-ink); color: var(--color-accent-on-ink); font-family: var(--font-display); font-weight: 700; font-size: 1.7rem; }
  .author-head__name { margin: 0 0 0.3rem; }
  .author-head__role { margin: 0; }
  .author { padding-top: 1.5rem; padding-bottom: 1rem; }
  .author__bio p { max-width: var(--measure); line-height: 1.68; }
  .author__bio :global(strong) { color: var(--color-text); }
  .author__links { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.25rem; }
  .author__section { margin: 2.5rem 0 0.75rem; font-size: 1.45rem; }
  @media (max-width: 520px) { .author-head__row { flex-direction: column; align-items: flex-start; gap: 0.8rem; } }
</style>
