---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { siteConfig } from '../siteConfig';

const tools = [
  { icon: '📐', title: 'Calculateur de dosage café', desc: 'Les grammes de café et la quantité d’eau exacts selon ta méthode et ton nombre de tasses.', href: '/calculateur-dosage-cafe/', cta: 'Ouvrir le calculateur' },
  { icon: '☕', title: 'Les méthodes de préparation', desc: 'Filtre, piston, moka, expresso… le bon geste et le bon matériel pour chaque méthode.', href: '/methodes-cafe/', cta: 'Voir les méthodes' },
];
---

<BaseLayout title="Outils gratuits" description={`Des outils gratuits pour réussir ton café à la maison : calculateur de dosage et guide des méthodes de préparation. ${siteConfig.name}.`}>
  <section class="container outils">
    <Breadcrumbs items={[{ label: 'Accueil', href: '/' }, { label: 'Outils gratuits' }]} />
    <header class="outils__head">
      <p class="outils__eyebrow">100 % gratuit · sans inscription</p>
      <h1>Outils gratuits</h1>
      <p class="outils__lede">Des outils pratiques pour réussir ton café sans te tromper — et à partager si ça peut aider quelqu’un.</p>
    </header>
    <div class="outils__grid">
      {tools.map((t) => (
        <article class="tool">
          <span class="tool__icon" aria-hidden="true">{t.icon}</span>
          <h2 class="tool__title"><a href={t.href}>{t.title}</a></h2>
          <p class="tool__desc">{t.desc}</p>
          <span class="tool__cta">{t.cta} →</span>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .outils { padding: 2.5rem 0 3.5rem; }
  .outils__head { max-width: 60ch; }
  .outils__eyebrow { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-accent); font-weight: 700; margin: 0 0 0.4rem; }
  .outils h1 { margin: 0; }
  .outils__lede { color: var(--color-text-muted); font-size: 1.05rem; margin-top: 0.7rem; }
  .outils__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.1rem; margin-top: 2.4rem; }
  .tool { position: relative; padding: 1.7rem 1.6rem; display: flex; flex-direction: column; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease; }
  .tool:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,0.08); border-color: var(--color-accent); }
  .tool__icon { font-size: 2rem; }
  .tool__title { margin: 0.7rem 0 0.4rem; font-size: 1.25rem; }
  .tool__title a { color: var(--color-text); text-decoration: none; }
  .tool__title a::after { content: ''; position: absolute; inset: 0; }
  .tool:hover .tool__title a { color: var(--color-accent); }
  .tool__desc { color: var(--color-text-muted); font-size: 0.95rem; margin: 0 0 1rem; flex: 1; }
  .tool__cta { color: var(--color-accent); font-weight: 600; font-size: 0.95rem; }
</style>
