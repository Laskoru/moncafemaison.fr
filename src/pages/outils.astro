---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { siteConfig } from '../siteConfig';

const tools = [
  { icon: 'calculator', title: 'Calculateur de dosage café', desc: 'Les grammes de café et la quantité d’eau exacts selon ta méthode, ton nombre de tasses et l’intensité que tu aimes.', href: '/calculateur-dosage-cafe/', cta: 'Ouvrir le calculateur' },
  { icon: 'droplet', title: 'Dureté de l’eau pour le café', desc: 'Ta commune, la dureté de ton eau du robinet d’après les analyses officielles, et ce qu’elle change pour le goût et le détartrage.', href: '/durete-eau-cafe/', cta: 'Voir la dureté de mon eau' },
  { icon: 'compass', title: 'Quelle méthode de café ?', desc: 'Espresso, moka, piston, filtre, cold brew, dosette : résultat en tasse, difficulté, budget et temps comparés, puis le matériel qui va avec.', href: '/methodes-cafe/', cta: 'Comparer les méthodes' },
  { icon: 'book', title: 'Lexique du café', desc: 'Mouture, crema, bars, blooming, sur-extraction : le vocabulaire expliqué en clair, avec le comparatif concerné quand il existe.', href: '/lexique/', cta: 'Ouvrir le lexique' },
];
---

<BaseLayout title="Outils gratuits" description={`Des outils gratuits pour réussir ton café à la maison : calculateur de dosage et guide des méthodes de préparation. ${siteConfig.name}.`}>
  <PageHead
    title="Outils gratuits"
    lede="Sans inscription : de quoi régler ta tasse et choisir ta méthode avant d’acheter quoi que ce soit."
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Outils gratuits' }]}
    width="narrow"
  />
  <section class="container outils">
    <ul class="rows">
      {tools.map((t) => (
        <li class="tool">
          <span class="tool__icon"><Icon name={t.icon} size={28} /></span>
          <div class="tool__body">
            <h2 class="tool__title"><a class="stretched-link" href={t.href}>{t.title}</a></h2>
            <p class="tool__desc">{t.desc}</p>
            <span class="tool__cta">{t.cta} <Icon name="arrow-right" size={16} /></span>
          </div>
        </li>
      ))}
    </ul>

    <div class="usage">
      <h2 class="usage__title">Comment t’en servir</h2>
      <p>Commence par le <a href="/methodes-cafe/">comparatif des méthodes</a> si tu hésites encore entre espresso, moka, piston ou filtre : il te montre quelle méthode colle à ton goût, à ton temps et à ton budget. Une fois ta méthode choisie, le <a href="/calculateur-dosage-cafe/">calculateur de dosage</a> te donne les quantités exactes pour le nombre de tasses que tu prépares.</p>
      <p>Pour le geste lui-même, chaque méthode a son guide pas à pas : <a href="/articles/reussir-espresso-maison/">espresso</a>, <a href="/articles/reussir-cafetiere-italienne-moka/">moka</a>, <a href="/articles/reussir-french-press-piston/">piston</a>, <a href="/articles/reussir-cafe-filtre-v60/">V60 et café filtre</a>, <a href="/articles/reussir-cold-brew-maison/">cold brew</a>. Et quand un mot t’échappe (crema, bloom, sur-extraction), le <a href="/lexique/">lexique</a> l’explique en clair.</p>
      <p>Regarde aussi la <a href="/durete-eau-cafe/">dureté de l’eau de ta commune</a> : une eau trop douce donne souvent un café plat, une eau trop dure entartre vite la machine. L’outil te dit où tu te situes, et si un <a href="/articles/meilleur-detartrant-machine-a-cafe/">détartrant</a> ou une carafe filtrante s’impose.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .outils { padding-top: 1.5rem; padding-bottom: 1rem; }
  .usage { margin-top: 1.5rem; padding-top: 1.75rem; border-top: 1px solid var(--color-border); max-width: 66ch; }
  .usage__title { margin: 0 0 0.75rem; font-size: 1.3rem; }
  .usage p { margin: 0 0 0.9rem; line-height: 1.65; color: var(--color-text); }
  .usage a { color: var(--color-accent); text-underline-offset: 0.18em; }
  .tool { position: relative; display: grid; grid-template-columns: auto 1fr; gap: 1.25rem; padding: 1.5rem 0.25rem; transition: background-color 0.15s ease; }
  .tool:hover { background: var(--color-surface); }
  .tool__icon { display: inline-flex; color: var(--color-accent); margin-top: 0.2rem; }
  .tool__title { margin: 0 0 0.35rem; font-size: 1.35rem; }
  .tool__title a { color: var(--color-text); text-decoration: none; }
  .tool:hover .tool__title a { color: var(--color-accent); }
  .tool__desc { margin: 0 0 0.6rem; color: var(--color-text-muted); line-height: 1.55; max-width: 60ch; }
  .tool__cta { display: inline-flex; align-items: center; gap: 0.35em; font-family: var(--font-ui); font-weight: 600; font-size: 0.92rem; color: var(--color-accent); }
  .tool__cta :global(svg) { transition: transform 0.2s var(--ease-out); }
  .tool:hover .tool__cta :global(svg) { transform: translateX(4px); }
</style>
