---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import { siteConfig } from '../../siteConfig';
import { categories } from '../../categories';
import { guides } from '../../guides';

export async function getStaticPaths() {
  return categories.map((cat) => ({
    params: { cat: cat.slug },
    props: { cat },
  }));
}

const { cat } = Astro.props;

const articles = (await getCollection('articles', ({ data }) => !data.draft && data.category === cat.slug)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
// Guides qui regroupent au moins un article de cette catégorie (maillage utile, pas décoratif).
const slugs = new Set(articles.map((a) => a.slug));
const relatedGuides = guides.filter((g) => g.articles.some((s) => slugs.has(s)));
---

<BaseLayout
  title={cat.label}
  noindex={articles.length === 0}
  description={`${cat.description} Tous les comparatifs ${cat.label.toLowerCase()} sur ${siteConfig.name}.`}
>
  <PageHead
    title={cat.label}
    lede={cat.description}
    crumbs={[{ label: 'Accueil', href: '/' }, { label: cat.label }]}
    count={articles.length ? `${articles.length} comparatif${articles.length > 1 ? 's' : ''}` : undefined}
  />

  <section class="wide list">
    <h2 class="sr-only">Les articles de cette catégorie</h2>
    {articles.length === 0 && <p class="empty">Aucun article publié dans cette catégorie pour le moment.</p>}
    <div class="grid">
      {articles.map((article, i) => <ArticleCard article={article} eager={i < 3} />)}
    </div>

    {relatedGuides.length > 0 && (
      <aside class="cat-guides" aria-label="Guides liés">
        <p class="cat-guides__label">Les guides qui reprennent ces comparatifs</p>
        <ul class="cat-guides__list">
          {relatedGuides.map((g) => (
            <li><a href={`/guides/${g.slug}/`}><Icon name={g.slug} size={18} /> {g.title}</a></li>
          ))}
        </ul>
      </aside>
    )}
  </section>
</BaseLayout>

<style>
  .list { padding-top: 2rem; padding-bottom: 1rem; }
  .empty { color: var(--color-text-muted); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }
  .cat-guides { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); }
  .cat-guides__label { margin: 0 0 0.8rem; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; }
  .cat-guides__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .cat-guides__list a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
  }
  .cat-guides__list a :global(svg) { color: var(--color-accent); }
  .cat-guides__list a:hover { border-color: var(--color-accent); color: var(--color-accent); }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
