---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { siteConfig } from '../siteConfig';

// Page pilier « par méthode » : comparer toutes les méthodes d'extraction, puis
// renvoyer vers le matériel et le calculateur. Aucune donnée inventée : ce sont
// des caractéristiques connues de chaque méthode.
interface Method {
  slug: string;
  name: string;
  icon: string;
  tasse: string;
  corps: number; // 1-5
  difficulte: number; // 1-5
  budget: string;
  temps: string;
  ideal: string;
  desc: string;
  links: { label: string; href: string }[];
}

const methods: Method[] = [
  {
    slug: 'espresso', name: 'Espresso', icon: 'espresso-machine',
    tasse: 'Court, intense, crema', corps: 5, difficulte: 4, budget: '€€€ – €€€€', temps: '≈ 1 min',
    ideal: "tu aimes l'intensité, le latte et le cappuccino",
    desc: "La méthode reine : de l'eau chaude sous pression traverse une mouture fine et tassée. Résultat concentré, corsé, surmonté d'une crema. Demande une machine, un bon moulin et un peu de pratique (mouture, tassage).",
    links: [
      { label: 'Comparatif machines expresso', href: '/articles/meilleure-machine-expresso/' },
      { label: 'Machines à broyeur intégré', href: '/articles/machine-expresso-broyeur-integre/' },
    ],
  },
  {
    slug: 'grain', name: 'Machine à grain', icon: 'bean',
    tasse: 'Espresso & café long automatiques', corps: 4, difficulte: 1, budget: '€€€ – €€€€', temps: '≈ 40 s',
    ideal: 'tu veux le café fraîchement moulu, sans effort',
    desc: "La machine moud le grain juste avant l'extraction, à la demande. Café frais et régulier d'un bouton, souvent avec mousse de lait. Investissement de départ, mais coût à la tasse très bas.",
    links: [{ label: 'Comparatif machines à grain', href: '/articles/meilleure-cafetiere-grains/' }],
  },
  {
    slug: 'moka', name: 'Cafetière italienne (moka)', icon: 'moka',
    tasse: 'Corsé, « espresso-like »', corps: 4, difficulte: 2, budget: '€', temps: '≈ 5 min',
    ideal: 'tu veux un café corsé, pour pas cher, sur le feu',
    desc: "Le classique inventé par Bialetti en 1933 : la vapeur pousse l'eau à travers la mouture. Café puissant sans machine coûteuse. Increvable, mais demande le bon réglage de feu et de mouture.",
    links: [{ label: 'Bien choisir sa cafetière italienne', href: '/articles/cafetiere-italienne-moka/' }],
  },
  {
    slug: 'piston', name: 'Piston (French press)', icon: 'press',
    tasse: 'Rond, corsé, huileux', corps: 4, difficulte: 1, budget: '€', temps: '≈ 4-5 min',
    ideal: 'tu cherches la simplicité et une grande tasse',
    desc: "Infusion libre : la mouture trempe dans l'eau chaude, puis un piston à filtre métallique sépare le marc. Sans filtre papier, les huiles restent : tasse ronde et corsée. Simple, sans électricité.",
    links: [{ label: 'Comparatif cafetières à piston', href: '/articles/meilleure-cafetiere-piston-french-press/' }],
  },
  {
    slug: 'filtre', name: 'Filtre / V60 (pour-over)', icon: 'dripper',
    tasse: 'Clair, aromatique, net', corps: 2, difficulte: 3, budget: '€ – €€', temps: '≈ 3-4 min',
    ideal: "tu veux révéler les arômes d'un café de spécialité",
    desc: "L'eau s'écoule à travers un filtre papier : tasse propre et parfumée, qui met en valeur les cafés de spécialité. En cafetière filtre c'est automatique et facile ; en V60 manuel, c'est plus technique (versement, mouture).",
    links: [
      { label: 'Cafetières filtre programmables', href: '/articles/meilleure-cafetiere-filtre-programmable/' },
      { label: 'La Chemex (filtre design)', href: '/articles/chemex-cafetiere-filtre-design/' },
    ],
  },
  {
    slug: 'dosette', name: 'Dosette / capsule', icon: 'box',
    tasse: 'Régulier, pratique', corps: 3, difficulte: 1, budget: '€ (machine)', temps: '≈ 30 s',
    ideal: 'tu veux zéro effort et zéro entretien de mouture',
    desc: "Une dose pré-emballée, un bouton : rapide, régulier, aucune mouture à gérer. Le revers : le coût à la tasse est le plus élevé, et le choix de cafés plus limité.",
    links: [{ label: 'Cafetières à dosette souple (ESE)', href: '/articles/cafetiere-dosette-souple-ese/' }],
  },
  {
    slug: 'coldbrew', name: 'Cold brew', icon: 'snowflake',
    tasse: 'Doux, peu acide, froid', corps: 3, difficulte: 1, budget: '€', temps: '12-24 h',
    ideal: "tu aimes le café froid, doux et désaltérant l'été",
    desc: "Extraction à froid : la mouture infuse 12 à 24 h au réfrigérateur. Résultat naturellement doux et peu acide, à servir sur glace. Aucun matériel spécifique, juste de la patience.",
    links: [{ label: 'Réussir son cold brew maison', href: '/articles/reussir-cold-brew-maison/' }],
  },
];

const faq = [
  { q: 'Quelle est la méthode la plus simple pour débuter ?', a: "La cafetière à piston (French press) : pas d'électricité, pas de réglage délicat, un ratio simple et une grande tasse. La cafetière italienne est une autre excellente porte d'entrée, très abordable." },
  { q: 'Quelle méthode donne le café le moins cher à la tasse ?', a: "Le café en grain (moulu à la demande) et la mouture classique (piston, moka, filtre) reviennent à 0,10–0,15 € la tasse, contre 0,30–0,50 € pour une capsule. La machine à grain coûte cher à l'achat mais se rentabilise vite si tu bois beaucoup de café." },
  { q: 'Faut-il un moulin quel que soit le choix ?', a: "Sauf pour les dosettes/capsules, oui : moudre son café juste avant l'extraction change tout au goût. Un moulin à meules (et non à lames) donne une mouture régulière, indispensable surtout pour l'espresso." },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout
  title="Quelle méthode pour ton café ? Le guide des méthodes d'extraction"
  description={`Espresso, moka, piston, filtre, cold brew, dosette : compare toutes les méthodes pour faire son café (résultat, corps, difficulté, budget, temps) et trouve celle qui te correspond. ${siteConfig.name}.`}
  jsonLd={jsonLd}
>
  <PageHead
    title="Quelle méthode pour ton café ?"
    lede="Avant de choisir une cafetière, choisis une méthode. Chacune donne une tasse différente et demande plus ou moins de matériel, de budget et de temps. Voici le panorama complet pour trouver la tienne, puis le matériel qui va avec."
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Outils', href: '/outils/' }, { label: 'Quelle méthode de café ?' }]}
    width="narrow"
  />

  <section class="container methodes">
    <h2 class="methodes__h2">Les méthodes en un coup d'œil</h2>
    <div class="table-wrap">
      <table class="table table--stack">
        <thead>
          <tr>
            <th scope="col">Méthode</th><th scope="col">Résultat en tasse</th><th scope="col">Corps</th><th scope="col">Facilité</th><th scope="col">Budget</th><th scope="col">Temps</th>
          </tr>
        </thead>
        <tbody>
          {methods.map((m) => (
            <tr>
              <th scope="row"><a href={`#${m.slug}`}>{m.name}</a></th>
              <td data-label="Résultat en tasse">{m.tasse}</td>
              <td data-label="Corps"><span class="dots" role="img" aria-label={`Corps ${m.corps} sur 5`}>{[1, 2, 3, 4, 5].map((n) => <i class:list={{ 'is-on': n <= m.corps }}></i>)}</span></td>
              <td data-label="Facilité"><span class="dots" role="img" aria-label={`Facilité ${6 - m.difficulte} sur 5`}>{[1, 2, 3, 4, 5].map((n) => <i class:list={{ 'is-on': n <= 6 - m.difficulte }}></i>)}</span></td>
              <td data-label="Budget">{m.budget}</td>
              <td data-label="Temps">{m.temps}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="table__note">« Facilité » : plus il y a de points pleins, plus la méthode est simple à réussir du premier coup.</p>

    <ul class="rows methodes__list">
      {methods.map((m) => (
        <li class="mrow" id={m.slug}>
          <span class="mrow__icon"><Icon name={m.icon} size={30} /></span>
          <div class="mrow__body">
            <h2 class="mrow__title">{m.name}</h2>
            <p class="mrow__ideal"><strong>Idéal si</strong> {m.ideal}.</p>
            <p class="mrow__desc">{m.desc}</p>
            <ul class="mrow__links">
              {m.links.map((l) => <li><a href={l.href}>{l.label} <Icon name="arrow-right" size={15} /></a></li>)}
            </ul>
          </div>
        </li>
      ))}
    </ul>

    <aside class="reflexes" aria-labelledby="reflexes-title">
      <h2 id="reflexes-title">Les deux réflexes qui changent tout</h2>
      <p>
        Quelle que soit la méthode, deux choses font 80 % du résultat : le <strong>bon ratio</strong> café/eau,
        et une <strong>mouture régulière</strong> moulue juste avant l'extraction.
      </p>
      <p class="reflexes__links">
        <a class="btn btn--primary" href="/calculateur-dosage-cafe/">Calculer mon dosage <Icon name="arrow-right" size={16} /></a>
        <a class="btn btn--outline" href="/articles/meilleur-moulin-cafe-electrique/">Choisir un moulin</a>
        <a class="btn btn--outline" href="/lexique/">Le lexique du café</a>
      </p>
    </aside>

    <section class="mfaq">
      <h2>Questions fréquentes</h2>
      <div class="mfaq__list">
        {faq.map((f) => (
          <details class="mfaq__item">
            <summary><span>{f.q}</span><Icon name="chevron-down" size={18} /></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .methodes { padding-top: 1.5rem; padding-bottom: 1rem; }
  .methodes__h2 { margin: 0.5rem 0 0.25rem; font-size: 1.45rem; }
  .table tbody th a { color: var(--color-text); text-decoration: none; }
  .table tbody th a:hover { color: var(--color-accent); text-decoration: underline; }
  /* Échelle 1–5 dessinée en CSS (pas de glyphe) */
  .dots { display: inline-flex; gap: 4px; vertical-align: middle; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; border: 1.5px solid var(--color-accent); background: transparent; }
  .dots i.is-on { background: var(--color-accent); }

  .methodes__list { margin-top: 2.5rem; }
  .mrow { display: grid; grid-template-columns: auto 1fr; gap: 1.25rem; padding: 1.75rem 0.25rem; scroll-margin-top: calc(var(--header-h) + 1rem); }
  .mrow__icon { display: inline-flex; color: var(--color-accent); margin-top: 0.2rem; }
  .mrow__title { margin: 0 0 0.4rem; font-size: 1.4rem; }
  .mrow__ideal { margin: 0 0 0.5rem; font-family: var(--font-ui); font-weight: 500; font-size: 0.95rem; color: var(--color-text-muted); }
  .mrow__ideal strong { color: var(--color-accent); font-weight: 700; }
  .mrow__desc { margin: 0 0 0.8rem; line-height: 1.6; color: var(--color-text-muted); max-width: 60ch; }
  .mrow__links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.2rem 1.4rem; }
  .mrow__links a { display: inline-flex; align-items: center; gap: 0.3em; min-height: 32px; font-family: var(--font-ui); font-weight: 600; font-size: 0.92rem; text-decoration: none; }
  .mrow__links a:hover { text-decoration: underline; }

  .reflexes { margin: 2.5rem 0; padding: 1.6rem 1.5rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); box-shadow: var(--shadow-card); }
  .reflexes h2 { margin: 0 0 0.5rem; font-size: 1.35rem; }
  .reflexes p { color: var(--color-text-muted); line-height: 1.6; margin: 0 0 1rem; }
  .reflexes strong { color: var(--color-text); }
  .reflexes__links { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0; }

  .mfaq h2 { font-size: 1.45rem; margin: 0 0 0.75rem; }
  .mfaq__list { border-top: 1px solid var(--color-border); }
  .mfaq__item { border-bottom: 1px solid var(--color-border); }
  .mfaq__item summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.9rem 0; cursor: pointer; list-style: none; font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; line-height: 1.3; }
  .mfaq__item summary::-webkit-details-marker { display: none; }
  .mfaq__item summary :global(svg) { flex: none; color: var(--color-text-faint); transition: transform 0.25s var(--ease-out); }
  .mfaq__item[open] summary :global(svg) { transform: rotate(180deg); }
  .mfaq__item summary:hover { color: var(--color-accent); }
  .mfaq__item p { margin: 0 0 1.1rem; color: var(--color-text-muted); line-height: 1.6; }

  @media (max-width: 520px) {
    .mrow { grid-template-columns: 1fr; gap: 0.5rem; }
    .reflexes__links .btn { width: 100%; }
  }
</style>
