---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { itemList } from '../../lib/schema';

const allArticles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Comparatifs café : machines, moulins, accessoires"
  description="Tous nos comparatifs et guides café, du plus récent au plus ancien : machines, moulins, accessoires, dosage et méthodes de préparation à la maison."
  jsonLd={itemList('Tous les comparatifs et guides', Astro.site, allArticles.map((a) => ({ id: a.id, title: a.data.title })))}
>
  <PageHead
    title="Tous les comparatifs et guides"
    lede="Du plus récent au plus ancien : machines, moulins, accessoires et méthodes de préparation."
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Tous les articles' }]}
    count={`${allArticles.length} article${allArticles.length > 1 ? 's' : ''}`}
  />
  <section class="wide list">
    <h2 class="sr-only">Tous les articles</h2>
    <div class="grid">
      {allArticles.map((article, i) => <ArticleCard article={article} eager={i < 3} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .list { padding-top: 2rem; padding-bottom: 1rem; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
