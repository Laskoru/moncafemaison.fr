---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../categories';

const latest = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Page introuvable" description="Cette page n'existe pas ou a été déplacée.">
  <section class="container not-found">
    <p class="eyebrow">Erreur 404</p>
    <h1>Cette page n'existe pas (ou plus)</h1>
    <p class="not-found__lede">
      Le lien est peut-être cassé ou la page a été déplacée. Voici comment retrouver ton chemin :
    </p>

    <div class="not-found__categories">
      {categories.map((cat) => (
        <a class="not-found__cat" href={`/categorie/${cat.slug}/`}>
          <span>{cat.icon}</span> {cat.label}
        </a>
      ))}
    </div>

    {latest.length > 0 && (
      <>
        <h2>Derniers articles</h2>
        <ul class="not-found__list">
          {latest.map((article) => (
            <li><a href={`/articles/${article.slug}/`}>{article.data.title}</a></li>
          ))}
        </ul>
      </>
    )}

    <a class="btn btn--primary" href="/">Retour à l'accueil</a>
  </section>
</BaseLayout>

<style>
  .not-found { padding: 3.5rem 0 4rem; }
  .not-found__lede { color: var(--color-text-muted); font-size: 1.05rem; margin-bottom: 2rem; }
  .not-found__categories { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-bottom: 2.5rem; }
  .not-found__cat {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.55em 1.1em;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-text);
  }
  .not-found__cat:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .not-found__list { padding-left: 1.2rem; margin-bottom: 2.5rem; }
  .not-found__list li { margin-bottom: 0.5rem; }
</style>
