---
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { categories } from '../categories';

const latest = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Page introuvable" description="Cette page n'existe pas ou a été déplacée." noindex>
  <PageHead
    title="Cette page n'existe pas (ou plus)"
    lede="Le lien est peut-être cassé ou la page a été déplacée. Voici comment retrouver ton chemin."
    count="Erreur 404"
    width="narrow"
  />
  <section class="container nf">
    <h2>Par catégorie</h2>
    <ul class="nf__cats">
      {categories.map((cat) => (
        <li>
          <a class="nf__cat" href={`/categorie/${cat.slug}/`}>
            <Icon name={cat.slug} size={18} /> {cat.label}
          </a>
        </li>
      ))}
    </ul>

    {latest.length > 0 && (
      <>
        <h2>Les derniers comparatifs</h2>
        <ul class="rows nf__list">
          {latest.map((article) => (
            <li><a href={`/articles/${article.slug}/`}>{article.data.title} <Icon name="arrow-right" size={16} /></a></li>
          ))}
        </ul>
      </>
    )}

    <p class="nf__home"><a class="btn btn--primary" href="/">Retour à l'accueil</a></p>
  </section>
</BaseLayout>

<style>
  .nf { padding-top: 1.5rem; padding-bottom: 1rem; }
  .nf h2 { font-size: 1.3rem; margin: 1.5rem 0 0.75rem; }
  .nf__cats { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .nf__cat {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
  }
  .nf__cat :global(svg) { color: var(--color-accent); }
  .nf__cat:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .nf__list li a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 48px; padding: 0.5rem 0.25rem; color: var(--color-text); font-family: var(--font-display); font-weight: 600; text-decoration: none; }
  .nf__list li a:hover { color: var(--color-accent); }
  .nf__list li a :global(svg) { flex: none; color: var(--color-accent); }
  .nf__home { margin: 2rem 0 0; }
</style>
