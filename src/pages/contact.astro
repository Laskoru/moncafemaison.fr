---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { siteConfig } from '../siteConfig';

const reasons = [
  { icon: 'bulb', title: 'Suggérer un comparatif', text: 'Une machine, un moulin ou un accessoire café que tu aimerais voir comparé ? Dis-le-nous, ça nous aide à choisir les prochains sujets.' },
  { icon: 'alert', title: 'Signaler une erreur', text: 'Un prix qui a changé, un lien cassé, une info à corriger ? Merci de nous prévenir : on tient à garder les articles à jour.' },
  { icon: 'shield', title: 'Partenariats', text: "Pour toute proposition, écris-nous à la même adresse en précisant l'objet. On répond aux demandes sérieuses et compatibles avec notre indépendance éditoriale." },
];
---

<BaseLayout
  title="Contact"
  description={`Contacter ${siteConfig.name} : question, suggestion de comparatif ou signalement.`}
>
  <PageHead
    title="Nous écrire"
    lede="Une question sur un article, une erreur à signaler, un produit ou une idée de comparatif à nous soumettre ? On lit tous les messages."
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Contact' }]}
    width="narrow"
  >
    <p class="contact__cta-wrap">
      <a class="btn btn--primary" href={`mailto:${siteConfig.contactEmail}`}>
        <Icon name="mail" size={18} /> {siteConfig.contactEmail}
      </a>
    </p>
  </PageHead>

  <section class="container contact">
    <ul class="rows">
      {reasons.map((r) => (
        <li class="reason">
          <span class="reason__icon"><Icon name={r.icon} size={24} /></span>
          <div>
            <h2 class="reason__title">{r.title}</h2>
            <p class="reason__text">{r.text}</p>
          </div>
        </li>
      ))}
    </ul>

    <p class="contact__note">
      Réponse généralement sous quelques jours. Pour les demandes relatives à tes données personnelles,
      consulte notre <a href="/politique-de-confidentialite/">politique de confidentialité</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .contact__cta-wrap { margin: 1.25rem 0 0; }
  .contact { padding-top: 1.5rem; padding-bottom: 1rem; }
  .reason { display: grid; grid-template-columns: auto 1fr; gap: 1rem; padding: 1.25rem 0.25rem; }
  .reason__icon { display: inline-flex; color: var(--color-accent); margin-top: 0.15rem; }
  .reason__title { margin: 0 0 0.3rem; font-size: 1.15rem; }
  .reason__text { margin: 0; color: var(--color-text-muted); font-size: 0.98rem; line-height: 1.6; max-width: 60ch; }
  .contact__note { margin: 2rem 0 0; color: var(--color-text-muted); font-size: 0.95rem; }
</style>
