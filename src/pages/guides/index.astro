---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import GuideList from '../../components/GuideList.astro';
import { siteConfig } from '../../siteConfig';
import { guides } from '../../guides';

const published = new Set((await getCollection('articles', ({ data }) => !data.draft)).map((a) => a.slug));
const guideItems = guides.map((g) => ({
  ...g,
  count: g.articles.filter((slug) => published.has(slug)).length,
}));
---

<BaseLayout
  title="Guides d’achat"
  description={`Nos guides thématiques café : débuter, réussir son espresso, café filtre. ${siteConfig.name}.`}
>
  <PageHead
    title="Guides par besoin"
    lede="Des parcours qui regroupent nos comparatifs autour d’un objectif précis, pour t’équiper étape par étape sans t’éparpiller."
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Guides' }]}
    width="narrow"
  />
  <section class="container guides">
    <h2 class="sr-only">Les guides</h2>
    <GuideList items={guideItems} />
    <p class="guides__more">
      Tu hésites encore sur la méthode ? Commence par <a href="/methodes-cafe/">le panorama des méthodes de café</a>, puis reviens ici pour le matériel.
    </p>
  </section>
</BaseLayout>

<style>
  .guides { padding-top: 1.5rem; padding-bottom: 1rem; }
  .guides__more { margin: 2rem 0 0; color: var(--color-text-muted); }
</style>
