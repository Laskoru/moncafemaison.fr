---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { siteConfig } from '../siteConfig';
import { categories } from '../categories';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const latest = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 10);

const categoryCounts = categories.map((cat) => ({
  ...cat,
  count: allArticles.filter((a) => a.data.category === cat.slug).length,
}));

const stats = [
  { value: String(allArticles.length), label: 'Comparatifs publiés' },
  { value: String(categories.length), label: 'Catégories couvertes' },
  { value: '100%', label: 'Rédaction indépendante' },
];
---

<BaseLayout title="Café maison : machines, moulins & accessoires comparés" description={siteConfig.description}>
  <section class="hero">
    <div class="wide hero__inner">
      <p class="hero__badge"><span class="hero__badge-dot"></span> Comparatifs indépendants · machines · moulins · accessoires</p>
      <h1 class="hero__title">{siteConfig.tagline}</h1>
      <p class="hero__lede">{siteConfig.description}</p>
      <div class="hero__actions">
        {latest.length > 0 && (
          <a class="btn btn--primary" href={`/articles/${latest[0].slug}/`}>Lire le dernier comparatif →</a>
        )}
        <a class="btn btn--glass" href="/articles/">Voir tous les articles</a>
      </div>

      <div class="hero__stats">
        {stats.map((stat) => (
          <div class="hero__stat">
            <p class="hero__stat-value">{stat.value}</p>
            <p class="hero__stat-label">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wide">
      <p class="section__eyebrow">Catégories</p>
      <h2 class="section__title">Trouve ce qu'il te faut</h2>
      <p class="section__lede">Nos comparatifs sont classés par ce que tu es en train d'équiper.</p>
      <div class="categories__grid">
        {categoryCounts.map((cat) => (
          <a class="categories__item card card--hover" href={`/categorie/${cat.slug}/`}>
            <span class="categories__icon">{cat.icon}</span>
            <span class="categories__label">{cat.label}</span>
            <span class="categories__desc">{cat.description}</span>
            <span class="categories__count">{cat.count} article{cat.count > 1 ? 's' : ''} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wide">
      <div class="section__head">
        <div>
          <p class="section__eyebrow">Derniers articles</p>
          <h2 class="section__title">Les comparatifs récents</h2>
        </div>
        <a class="section__link" href="/articles/">Voir tout →</a>
      </div>
      <div class="article-list">
        {latest.length === 0 && <p>Aucun article publié pour le moment.</p>}
        {latest.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wide approach">
      <div class="approach__text">
        <p class="section__eyebrow">Notre approche</p>
        <h2 class="section__title">Des conseils utiles, pas du blabla</h2>
        <p>
          Chaque article part d'un usage concret — un espresso serré le matin, un grand filtre le week-end,
          un latte mousseux — et compare des critères <strong>concrets</strong> : type de mouture, pression,
          régularité, entretien, budget. Pas d'impressions vagues ni de classements gonflés artificiellement.
        </p>
        <p>
          On assume nos choix et leurs compromis, et les comparatifs sont revus régulièrement pour que les
          modèles conseillés et les prix restent d'actualité.
        </p>
        <a class="btn btn--outline" href="/a-propos">En savoir plus sur nous</a>
      </div>
      <ul class="approach__points">
        <li><span>✓</span> Critères concrets et vérifiables</li>
        <li><span>✓</span> Sélections par budget et par usage</li>
        <li><span>✓</span> Rédaction indépendante, financée par l'affiliation</li>
        <li><span>✓</span> Articles mis à jour dans le temps</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #fff;
    background-color: #1c130c;
    background-image:
      linear-gradient(96deg, rgba(28, 19, 12, 0.94) 0%, rgba(28, 19, 12, 0.72) 46%, rgba(28, 19, 12, 0.32) 100%),
      linear-gradient(180deg, rgba(28, 19, 12, 0.3) 0%, rgba(28, 19, 12, 0) 34%, var(--color-bg) 100%),
      url('https://images.unsplash.com/photo-1475296204602-08d15839e95f?q=80&w=2000&auto=format&fit=crop');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  /* halo d'accent, discret */
  .hero::before {
    content: '';
    position: absolute;
    top: -20%;
    right: -10%;
    width: 55%;
    height: 90%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--color-accent) 30%, transparent), transparent 70%);
    filter: blur(30px);
    z-index: -1;
    pointer-events: none;
  }
  .hero__inner {
    padding: clamp(4rem, 13vh, 8rem) 1.25rem clamp(3.5rem, 9vh, 6rem);
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(6px);
    padding: 0.5em 1em;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: rgba(255, 255, 255, 0.92);
    margin: 0 0 1.5rem;
  }
  .hero__badge-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--color-signal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-signal) 30%, transparent);
  }
  .hero__title {
    font-size: clamp(2.3rem, 5.2vw, 3.9rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 1.2rem;
    max-width: 17ch;
    text-wrap: balance;
  }
  .hero__lede {
    font-size: clamp(1.02rem, 1.6vw, 1.18rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.82);
    max-width: 56ch;
    margin: 0 0 2rem;
  }
  .hero__actions { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 3rem; }
  .btn--glass {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(6px);
  }
  .btn--glass:hover { background: rgba(255, 255, 255, 0.16); border-color: rgba(255, 255, 255, 0.5); }

  .hero__stats {
    display: flex;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    flex-wrap: wrap;
    padding-top: 1.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    max-width: 560px;
  }
  .hero__stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    font-weight: 700;
    margin: 0;
    color: #fff;
  }
  .hero__stat-label {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.65);
    margin: 0.2rem 0 0;
  }

  /* ---- Sections génériques ---- */
  .section { padding: 3.6rem 0; }
  .section--soft { background: var(--color-bg-soft); }
  .section__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 0.5rem;
  }
  .section__title { margin: 0 0 0.5rem; font-size: clamp(1.5rem, 3vw, 2rem); }
  .section__lede { color: var(--color-text-muted); margin: 0 0 1.8rem; max-width: 60ch; }
  .section__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.8rem;
  }
  .section__head .section__title { margin-bottom: 0; }
  .section__link {
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--color-accent);
    white-space: nowrap;
  }
  .section__link:hover { text-decoration: underline; }

  /* ---- Catégories ---- */
  .categories__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .categories__item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    padding: 1.6rem 1.5rem;
  }
  .categories__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    font-size: 1.5rem;
    border-radius: 12px;
    background: var(--color-accent-soft);
    margin-bottom: 1rem;
  }
  .categories__label { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; }
  .categories__desc { color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.5; margin: 0.3rem 0 1rem; flex: 1; }
  .categories__count { font-size: 0.82rem; font-weight: 600; color: var(--color-accent); }

  /* ---- Derniers articles ---- */
  .article-list { display: flex; flex-direction: column; gap: 1rem; }

  /* ---- Approche ---- */
  .approach {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .approach__text .section__title { margin-bottom: 1rem; }
  .approach__text p { color: var(--color-text-muted); line-height: 1.7; }
  .approach__text .btn { margin-top: 0.8rem; }
  .approach__points {
    list-style: none;
    margin: 0;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .approach__points li { display: flex; gap: 0.7rem; align-items: flex-start; line-height: 1.4; }
  .approach__points span {
    color: var(--color-accent);
    font-weight: 700;
    flex-shrink: 0;
  }

  @media (max-width: 780px) {
    .approach { grid-template-columns: 1fr; gap: 1.6rem; }
  }
  @media (max-width: 680px) {
    .categories__grid { grid-template-columns: 1fr; }
  }
</style>
