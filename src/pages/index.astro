---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import GuideList from '../components/GuideList.astro';
import SelectionMethod from '../components/SelectionMethod.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../siteConfig';
import { categories } from '../categories';
import { guides } from '../guides';
import { resolveCoverImage, coverSrcSet } from '../lib/covers';

const allArticles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const lead = allArticles[0];
const latest = allArticles.slice(1, 7);

const categoryCounts = categories.map((cat) => ({
  ...cat,
  count: allArticles.filter((a) => a.data.category === cat.slug).length,
}));

const published = new Set(allArticles.map((a) => a.slug));
const guideItems = guides.map((g) => ({
  ...g,
  count: g.articles.filter((slug) => published.has(slug)).length,
}));

const leadCover = lead ? resolveCoverImage(lead.slug, lead.data.coverImage) : null;
const leadCat = lead ? categories.find((c) => c.slug === lead.data.category) : undefined;
const leadMinutes = lead ? Math.max(1, Math.round(lead.body.trim().split(/\s+/).length / 200)) : 0;
const dateFormatter = new Intl.DateTimeFormat(siteConfig.locale.replace('_', '-'), { year: 'numeric', month: 'long', day: 'numeric' });

const tools = [
  { icon: 'calculator', title: 'Calculateur de dosage', desc: 'Les grammes de café et la quantité d’eau exacts selon ta méthode, ton nombre de tasses et ton goût.', href: '/calculateur-dosage-cafe/', cta: 'Calculer mon dosage' },
  { icon: 'compass', title: 'Quelle méthode de café ?', desc: 'Espresso, moka, piston, filtre, cold brew : le panorama pour choisir la méthode avant la machine.', href: '/methodes-cafe/', cta: 'Comparer les méthodes' },
];
---

<BaseLayout title="Mon Café Maison — machines, moulins & accessoires comparés" description={siteConfig.description}>
  {lead && (
    <section class="une" aria-labelledby="site-title">
      <div class="wide une__grid">
        <a class="une__media" href={`/articles/${lead.slug}/`} tabindex="-1" aria-hidden="true">
          {leadCover ? (
            <img
              src={leadCover}
              srcset={coverSrcSet(leadCover)}
              sizes="(max-width: 900px) 100vw, 660px"
              alt=""
              width="1600"
              height="900"
              fetchpriority="high"
            />
          ) : (
            <span class="une__ph"><Icon name={leadCat?.slug ?? 'cup'} size={56} /></span>
          )}
        </a>
        <div class="une__text">
          <h1 class="une__title" id="site-title">Le bon café à la maison, méthode d'abord</h1>
          <div class="une__story">
            <h2 class="une__story-title"><a href={`/articles/${lead.slug}/`}>{lead.data.title}</a></h2>
            <p class="meta meta-row une__story-meta">
              {leadCat && <span class="cat-label">{leadCat.label}</span>}
              <time datetime={lead.data.pubDate.toISOString().slice(0, 10)}>{dateFormatter.format(lead.data.pubDate)}</time>
              <span>{leadMinutes} min de lecture</span>
            </p>
            <p class="une__story-desc">{lead.data.description}</p>
            <a class="btn btn--primary une__cta" href={`/articles/${lead.slug}/`}>Lire le comparatif <Icon name="arrow-right" size={18} /></a>
          </div>
        </div>
      </div>
    </section>
  )}

  <nav class="cats" aria-label="Catégories">
    <ul class="wide cats__row">
      {categoryCounts.map((cat) => (
        <li>
          <a class="cats__item" href={`/categorie/${cat.slug}/`}>
            <span class="cats__icon"><Icon name={cat.slug} size={28} /></span>
            <span class="cats__name">{cat.label}</span>
            <span class="meta cats__count">{cat.count} comparatif{cat.count > 1 ? 's' : ''}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <section class="wide section" aria-labelledby="start-title">
    <div class="section-head">
      <h2 id="start-title">Par où commencer</h2>
      <a class="section-head__link" href="/guides/">Tous les guides <Icon name="arrow-right" size={16} /></a>
    </div>
    <GuideList items={guideItems} />
  </section>

  <section class="wide section" aria-labelledby="latest-title">
    <div class="section-head">
      <h2 id="latest-title">Les derniers comparatifs</h2>
      <a class="section-head__link" href="/articles/">Tous les comparatifs <Icon name="arrow-right" size={16} /></a>
    </div>
    <div class="latest-grid">
      {latest.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>

  <section class="tools" aria-labelledby="tools-title">
    <div class="wide tools__in">
      <div class="tools__head">
        <h2 id="tools-title">Nos outils</h2>
        <p>Gratuits, sans inscription : de quoi régler ta tasse avant d'acheter quoi que ce soit.</p>
      </div>
      <ul class="tools__list">
        {tools.map((t) => (
          <li class="tools__item">
            <span class="tools__icon"><Icon name={t.icon} size={28} /></span>
            <h3 class="tools__title"><a class="stretched-link" href={t.href}>{t.title}</a></h3>
            <p class="tools__desc">{t.desc}</p>
            <span class="tools__cta">{t.cta} <Icon name="arrow-right" size={16} /></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wide section section--last">
    <SelectionMethod wide />
  </section>
</BaseLayout>

<style>
  /* ---- La « une » : couverture du comparatif du moment + décision en une ligne ---- */
  .une { padding: 2rem 0 2.5rem; }
  .une__grid {
    display: grid;
    grid-template-columns: 58fr 42fr;
    gap: 2.5rem;
    align-items: center;
  }
  .une__media {
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    animation: une-media 0.9s var(--ease-out) both;
  }
  .une__media img { width: 100%; height: 100%; object-fit: cover; }
  .une__ph { display: flex; align-items: center; justify-content: center; height: 100%; color: var(--color-accent); }
  .une__text { animation: une-text 0.9s var(--ease-out) both; }
  @keyframes une-media { from { opacity: 0.4; transform: scale(1.015); } to { opacity: 1; transform: none; } }
  @keyframes une-text { from { opacity: 0.4; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .une__title {
    margin: 0 0 1.1rem;
    font-size: clamp(2rem, 1.3rem + 2.2vw, 2.6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 16ch;
  }
  .une__story { padding-top: 1.1rem; border-top: 1px solid var(--color-border); }
  .une__story-title { margin: 0 0 0.5rem; font-size: 1.5rem; font-weight: 600; line-height: 1.2; letter-spacing: -0.01em; }
  .une__story-title a { color: var(--color-text); text-decoration: none; }
  .une__story-title a:hover { color: var(--color-accent); text-decoration: underline; text-decoration-thickness: 2px; }
  .une__story-meta { margin-bottom: 0.75rem; }
  .une__story-desc { margin: 0 0 1.25rem; color: var(--color-text-muted); line-height: 1.55; max-width: 48ch; }
  .une__cta { padding-inline: 1.5em; }

  /* ---- Rangée de catégories à filets ---- */
  .cats { border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); background: var(--color-surface); }
  .cats__row { list-style: none; margin: 0 auto; padding: 0 1.25rem; display: grid; grid-template-columns: repeat(4, 1fr); }
  .cats__row li { border-left: 1px solid var(--color-border); }
  .cats__row li:first-child { border-left: 0; }
  .cats__item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-height: 44px;
    padding: 1.25rem 1.4rem;
    color: var(--color-text);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .cats__item:hover { background: var(--color-bg); }
  .cats__icon { display: inline-flex; color: var(--color-accent); margin-bottom: 0.25rem; }
  .cats__name { font-family: var(--font-display); font-weight: 700; font-size: 1.08rem; line-height: 1.2; }
  .cats__item:hover .cats__name { color: var(--color-accent); }
  .cats__count { margin: 0; }

  /* ---- Sections ---- */
  .section { padding-top: 3.25rem; }
  .section--last { padding-top: 1.5rem; }
  .latest-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }

  /* ---- Nos outils : encart encre ---- */
  .tools { margin-top: 3.5rem; background: var(--color-ink); color: var(--color-on-ink); }
  .tools__in { display: grid; grid-template-columns: 1fr 2fr; gap: 2.5rem; padding-top: 3rem; padding-bottom: 3rem; }
  .tools__head h2 { margin: 0 0 0.6rem; color: var(--color-on-ink); font-size: 1.7rem; }
  .tools__head p { margin: 0; color: var(--color-on-ink-muted); line-height: 1.55; max-width: 30ch; }
  .tools__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; }
  .tools__item { position: relative; display: flex; flex-direction: column; gap: 0.5rem; padding: 0.25rem 1.75rem 0.25rem 0; }
  .tools__item + .tools__item { padding-left: 1.75rem; padding-right: 0; border-left: 1px solid rgba(251, 248, 243, 0.18); }
  .tools__icon { display: inline-flex; color: var(--color-accent-on-ink); }
  .tools__title { margin: 0.25rem 0 0; font-size: 1.3rem; color: var(--color-on-ink); }
  .tools__title a { color: inherit; text-decoration: none; }
  .tools__item:hover .tools__title a { color: var(--color-accent-on-ink); }
  .tools__desc { margin: 0; color: var(--color-on-ink-muted); font-size: 0.98rem; line-height: 1.55; }
  .tools__cta { display: inline-flex; align-items: center; gap: 0.35em; margin-top: auto; padding-top: 0.5rem; font-family: var(--font-ui); font-weight: 600; font-size: 0.92rem; color: var(--color-accent-on-ink); }
  .tools__cta :global(svg) { transition: transform 0.2s var(--ease-out); }
  .tools__item:hover .tools__cta :global(svg) { transform: translateX(4px); }

  @media (max-width: 1000px) {
    .latest-grid { grid-template-columns: repeat(2, 1fr); }
    .tools__in { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  @media (max-width: 900px) {
    .une { padding: 1.25rem 0 2rem; }
    .une__grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .une__title { max-width: none; }
    .une__cta { width: 100%; }
    .cats__row { grid-template-columns: 1fr 1fr; }
    .cats__row li:nth-child(odd) { border-left: 0; }
    .cats__row li:nth-child(n + 3) { border-top: 1px solid var(--color-border); }
    .cats__item { padding: 1rem 1rem; }
  }
  @media (max-width: 640px) {
    .cats__row { padding: 0 1rem; }
    .latest-grid { grid-template-columns: 1fr; }
    .tools__list { grid-template-columns: 1fr; }
    .tools__item { padding: 1rem 0; border-top: 1px solid rgba(251, 248, 243, 0.18); }
    .tools__item + .tools__item { padding-left: 0; border-left: 0; }
    .tools__in { padding-top: 2.25rem; padding-bottom: 2.25rem; }
    .section { padding-top: 2.5rem; }
  }
</style>
