---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';

// Réglages du calculateur : source unique pour le script, le tableau et la FAQ.
// cup = volume d'une « tasse » en ml (hypothèse affichée), ratio = g d'eau par g de café.
const M = {
  filtre:    { cup: 125, ratio: 17,   grind: 'moyenne',       tip: 'Verse l’eau à ~93 °C en plusieurs fois pour une extraction régulière.' },
  v60:       { cup: 220, ratio: 16,   grind: 'moyenne-fine',  tip: 'Fais une pré-infusion (bloom) de 30 s avant de continuer à verser.' },
  piston:    { cup: 220, ratio: 15,   grind: 'grossière',     tip: 'Laisse infuser 4 minutes avant de presser doucement.' },
  italienne: { cup: 60,  ratio: 10,   grind: 'fine',          tip: 'Remplis le panier sans tasser, et retire du feu dès que ça monte.' },
  expresso:  { cup: 30,  ratio: 3,    grind: 'très fine',     tip: 'Vise 25 à 30 s d’extraction pour un espresso équilibré.' },
};
const STRENGTH = { doux: 1.08, normal: 1, corse: 0.92 };
const grams = (ml: number, ratio: number) => Math.round((ml / ratio) * 2) / 2; // arrondi 0,5 g
const nf = (n: number) => n.toLocaleString('fr-FR', { maximumFractionDigits: 1 });
const vol = (ml: number) => (ml >= 1000 ? `${nf(ml / 1000)} L` : `${ml} ml`);
const filtreRows = [2, 4, 6, 8, 10, 12].map((n) => ({
  n,
  water: vol(n * M.filtre.cup),
  normal: nf(grams(n * M.filtre.cup, M.filtre.ratio)),
  doux: nf(grams(n * M.filtre.cup, M.filtre.ratio * STRENGTH.doux)),
  corse: nf(grams(n * M.filtre.cup, M.filtre.ratio * STRENGTH.corse)),
}));
const perCup = [
  { name: 'Café filtre (cafetière)', key: 'filtre' },
  { name: 'V60 / pour-over', key: 'v60' },
  { name: 'Piston (French press)', key: 'piston' },
  { name: 'Cafetière italienne (moka)', key: 'italienne' },
  { name: 'Expresso', key: 'expresso' },
].map((r) => {
  const m = M[r.key as keyof typeof M];
  return { ...r, cup: vol(m.cup), g: nf(grams(m.cup, m.ratio)), ratio: `1 : ${nf(m.ratio)}`, grind: m.grind };
});
const row = (n: number) => filtreRows.find((r) => r.n === n)!;

const faq = [
  {
    q: 'Combien de café moulu pour 4 tasses de café filtre ?',
    a: `Environ ${row(4).normal} g de café moulu pour ${row(4).water} d’eau, avec une mouture moyenne. Pour un café plus léger, descends vers ${row(4).doux} g ; pour un café plus corsé, monte vers ${row(4).corse} g.`,
  },
  {
    q: 'Quel dosage pour 6 tasses de café filtre ?',
    a: `Compte environ ${row(6).normal} g de café moulu pour ${row(6).water} d’eau. La fourchette utile va de ${row(6).doux} g (doux) à ${row(6).corse} g (corsé).`,
  },
  {
    q: 'Combien de café pour une cafetière filtre de 10 tasses ?',
    a: `Pour une verseuse pleine de 10 tasses (${row(10).water}), environ ${row(10).normal} g de café moulu. Si tu n’en fais que la moitié, divise simplement par deux.`,
  },
  {
    q: 'Combien de grammes de café par tasse ?',
    a: `Cela dépend de la méthode : environ ${perCup[0].g} g pour une tasse de café filtre de 125 ml, ${perCup[3].g} g pour une tasse de moka de 60 ml et ${perCup[4].g} g pour un expresso de 30 ml. Le tableau « une tasse, méthode par méthode » plus bas donne toutes les valeurs.`,
  },
  {
    q: 'Combien de cuillères de café moulu par tasse ?',
    a: 'Une cuillère ne pèse pas toujours la même chose : tout dépend de sa taille, de la mouture et de la façon de la remplir. Le plus fiable est de peser une fois ta cuillère habituelle pleine sur une balance de cuisine, puis de convertir les grammes du calculateur en cuillères.',
  },
  {
    q: 'Quel est le ratio café / eau de référence ?',
    a: 'La Specialty Coffee Association teste les cafetières filtre domestiques avec 55 g de café pour 1 kg d’eau (norme SCA 310-2021), soit un ratio d’environ 1 : 18. Le réglage « Normal » du calculateur (1 : 17) donne un café un peu plus soutenu ; le réglage « Doux » est proche de la référence SCA.',
  },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

// Guides pas à pas par méthode : liens statiques (découverte par Google + suite logique du dosage).
const guidesMethode = [
  { name: 'Espresso', hint: 'Mouture très fine, 25 à 30 s d’extraction', href: '/articles/reussir-espresso-maison/' },
  { name: 'Cafetière italienne (moka)', hint: 'Mouture fine, panier rempli sans tasser', href: '/articles/reussir-cafetiere-italienne-moka/' },
  { name: 'Piston (French press)', hint: 'Mouture grossière, 4 minutes d’infusion', href: '/articles/reussir-french-press-piston/' },
  { name: 'V60 et café filtre', hint: 'Mouture moyenne-fine, bloom de 30 s', href: '/articles/reussir-cafe-filtre-v60/' },
  { name: 'Cold brew', hint: 'Infusion longue à froid, café doux et peu acide', href: '/articles/reussir-cold-brew-maison/' },
];
---

<BaseLayout
  title="Dosage café filtre et moulu : calculateur par tasse"
  description="Dosage du café filtre pour 2, 4, 6 ou 10 tasses : grammes de café moulu et quantité d'eau en un clic, avec un tableau prêt à l'emploi par méthode."
  jsonLd={faqSchema}
>
  <PageHead
    title="Dosage du café : combien de grammes par tasse ?"
    lede={`Réponse courte : environ ${perCup[0].g} g de café moulu par tasse de café filtre (125 ml), soit ${row(4).normal} g pour 4 tasses et ${row(6).normal} g pour 6 tasses. Pour une autre méthode ou un autre nombre de tasses, le calculateur ci-dessous fait le compte.`}
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Outils', href: '/outils/' }, { label: 'Calculateur de dosage' }]}
    width="narrow"
  />

  <section class="container calc">
    <div class="calc__grid">
      <form class="calc__controls" id="calc-form" aria-label="Réglages du dosage">
        <label class="field">
          <span class="field__label">Méthode</span>
          <span class="select">
            <select id="method">
              <option value="filtre">Café filtre / cafetière</option>
              <option value="v60">V60 / pour-over</option>
              <option value="piston">Piston (French press)</option>
              <option value="italienne">Cafetière italienne (moka)</option>
              <option value="expresso">Expresso</option>
            </select>
            <Icon name="chevron-down" size={18} />
          </span>
        </label>

        <label class="field">
          <span class="field__label">Nombre de tasses <b id="cups-val">2</b></span>
          <input type="range" id="cups" min="1" max="12" value="2" step="1" />
        </label>

        <div class="field">
          <span class="field__label">Intensité</span>
          <div class="seg" role="group" aria-label="Intensité">
            <button type="button" data-s="doux">Doux</button>
            <button type="button" data-s="normal" class="is-active" aria-pressed="true">Normal</button>
            <button type="button" data-s="corse">Corsé</button>
          </div>
        </div>
      </form>

      <div class="calc__result" aria-live="polite">
        <div class="result__row">
          <div class="result__block">
            <span class="result__num" id="out-coffee">{nf(grams(2 * M.filtre.cup, M.filtre.ratio))}</span><span class="result__unit">g</span>
            <p class="result__cap">de café moulu</p>
          </div>
          <div class="result__block">
            <span class="result__num" id="out-water">{2 * M.filtre.cup}</span><span class="result__unit" id="out-water-unit">ml</span>
            <p class="result__cap">d’eau</p>
          </div>
        </div>
        <dl class="result__meta">
          <div><dt>Mouture conseillée</dt><dd id="out-grind">moyenne</dd></div>
          <div><dt>Ratio café / eau</dt><dd id="out-ratio">1 : {nf(M.filtre.ratio)}</dd></div>
        </dl>
        <p class="result__tip"><Icon name="bulb" size={18} /><span id="out-tip">{M.filtre.tip}</span></p>
      </div>
    </div>

    <p class="calc__note">
      Le calculateur compte <b>125 ml par tasse de café filtre</b> : c’est une hypothèse, pas une norme.
      Regarde la graduation de ta verseuse ; si elle indique un autre volume, raisonne en millilitres.
      Ces chiffres sont un point de départ : ajuste ensuite à ton goût, d’un ou deux grammes à la fois.
    </p>

    <div class="dose">
      <h2 id="dosage-cafe-filtre">Dosage du café filtre selon le nombre de tasses</h2>
      <p>Pour une cafetière filtre électrique ou un filtre manuel, avec une mouture moyenne et 125 ml d’eau par tasse :</p>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th scope="col">Tasses</th><th scope="col">Eau</th><th scope="col">Café moulu (normal)</th><th scope="col">Doux / corsé</th></tr>
          </thead>
          <tbody>
            {filtreRows.map((r) => (
              <tr><th scope="row">{r.n} tasses</th><td>{r.water}</td><td><strong>{r.normal} g</strong></td><td>{r.doux} à {r.corse} g</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>Une cafetière de 10 ou 12 tasses peut aussi servir pour 2 ou 4 : le dosage suit le volume d’eau versé, pas la taille de la machine. Pour choisir l’appareil, vois notre guide de la <a href="/articles/meilleure-cafetiere-filtre-programmable/">cafetière filtre programmable</a>.</p>

      <h2 id="une-tasse-par-methode">Une tasse, méthode par méthode</h2>
      <div class="table-wrap">
        <table class="table table--stack">
          <thead>
            <tr><th scope="col">Méthode</th><th scope="col">Une tasse</th><th scope="col">Café moulu</th><th scope="col">Ratio</th><th scope="col">Mouture</th></tr>
          </thead>
          <tbody>
            {perCup.map((r) => (
              <tr><th scope="row">{r.name}</th><td data-label="Une tasse">{r.cup}</td><td data-label="Café moulu"><strong>{r.g} g</strong></td><td data-label="Ratio">{r.ratio}</td><td data-label="Mouture">{r.grind}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>Pour la moka, le panier se remplit à ras sans tasser : la quantité dépend surtout de la taille de ta cafetière (voir <a href="/articles/cafetiere-italienne-moka/">comment choisir sa cafetière italienne</a>). Pour l’expresso, le panier du porte-filtre fixe la dose : pèse-la avec une <a href="/articles/balance-cafe-precision/">balance de précision</a>.</p>

      <h2 id="peser-ou-doser">Peser plutôt que compter les cuillères</h2>
      <p>Les grammes sont plus fiables que les cuillères : une cuillère de café moulu fin ne pèse pas la même chose qu’une cuillère de mouture grossière. Si tu n’as pas de balance, pèse une fois ta cuillère habituelle pleine sur une balance de cuisine et note le résultat. Et si ton café reste amer ou plat malgré le bon dosage, regarde la mouture et la fraîcheur des grains avant de changer de machine : notre comparatif des <a href="/articles/moulin-cafe-meules-ou-lames/">moulins à meules ou à lames</a> explique pourquoi.</p>
    </div>

    <div class="methodes">
      <h2 class="methodes__title">Réussir ta méthode, pas à pas</h2>
      <p class="methodes__lede">Le dosage fait la moitié du travail. Le geste fait le reste : chaque guide détaille la mouture, le temps et les erreurs à éviter pour une méthode.</p>
      <ul class="methodes__list">
        {guidesMethode.map((g) => (
          <li><a href={g.href}><span class="methodes__name">{g.name}</span><span class="methodes__hint">{g.hint}</span></a></li>
        ))}
      </ul>
    </div>

    <div class="dose dose--faq">
      <h2>Questions fréquentes sur le dosage du café</h2>
      {faq.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
      <p class="dose__src">
        Source : <a href="https://sca.coffee/s/SCA_Standard_310-2021.pdf" rel="noopener" target="_blank">Specialty Coffee Association, norme SCA 310-2021 « Home Coffee Brewers »</a> (ratio de test de 55 g de café par kg d’eau, eau entre 90 et 96 °C).
        À voir aussi : <a href="/durete-eau-cafe/">la dureté de l’eau de ta commune</a> et <a href="/methodes-cafe/">le comparatif des méthodes</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ M, STRENGTH }}>
  (function () {
    var strength = 'normal';

    var method = document.getElementById('method');
    var cups = document.getElementById('cups');
    var cupsVal = document.getElementById('cups-val');
    var outCoffee = document.getElementById('out-coffee');
    var outWater = document.getElementById('out-water');
    var outWaterUnit = document.getElementById('out-water-unit');
    var outGrind = document.getElementById('out-grind');
    var outRatio = document.getElementById('out-ratio');
    var outTip = document.getElementById('out-tip');
    var segBtns = document.querySelectorAll('.seg button');

    function fr(n, d) { return n.toLocaleString('fr-FR', { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 }); }

    function update() {
      var m = M[method.value];
      var n = parseInt(cups.value, 10);
      cupsVal.textContent = n;
      var ratio = m.ratio * STRENGTH[strength];
      var waterMl = n * m.cup;
      var coffeeG = waterMl / ratio;
      coffeeG = Math.round(coffeeG * 2) / 2; // arrondi 0,5 g

      outCoffee.textContent = fr(coffeeG, coffeeG % 1 === 0 ? 0 : 1);
      if (waterMl >= 1000) {
        outWater.textContent = fr(waterMl / 1000, 1);
        outWaterUnit.textContent = 'L';
      } else {
        outWater.textContent = fr(waterMl);
        outWaterUnit.textContent = 'ml';
      }
      outGrind.textContent = m.grind;
      outRatio.textContent = '1 : ' + fr(ratio, 1);
      outTip.textContent = m.tip;
    }

    method.addEventListener('change', update);
    cups.addEventListener('input', update);
    segBtns.forEach(function (b) {
      b.addEventListener('click', function () {
        strength = b.getAttribute('data-s');
        segBtns.forEach(function (x) { x.classList.remove('is-active'); x.setAttribute('aria-pressed', 'false'); });
        b.classList.add('is-active'); b.setAttribute('aria-pressed', 'true');
        update();
      });
    });
    // Lien direct depuis un article : /calculateur-dosage-cafe/?methode=italienne&tasses=6
    var q = new URLSearchParams(location.search);
    if (M[q.get('methode')]) method.value = q.get('methode');
    var t = parseInt(q.get('tasses'), 10);
    if (t >= 1 && t <= 12) cups.value = String(t);
    update();
  })();
</script>

<style>
  .calc { padding-top: 2rem; padding-bottom: 1rem; }
  .calc__grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 1.25rem; align-items: stretch; }
  .calc__controls, .calc__result {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
  }
  .calc__controls { padding: 1.5rem; display: flex; flex-direction: column; gap: 1.4rem; }

  .field { display: flex; flex-direction: column; gap: 0.55rem; }
  .field__label { font-family: var(--font-ui); font-weight: 600; font-size: 0.95rem; }
  .field__label b { color: var(--color-accent); font-variant-numeric: tabular-nums; }
  .select { position: relative; display: block; }
  .select :global(svg) { position: absolute; right: 0.8rem; top: 50%; transform: translateY(-50%); pointer-events: none; color: var(--color-text-faint); }
  select {
    width: 100%;
    min-height: 44px;
    padding: 0.6rem 2.4rem 0.6rem 0.8rem;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 1rem;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    appearance: none;
    -webkit-appearance: none;
  }
  select:hover { border-color: var(--color-accent); }
  input[type='range'] { accent-color: var(--color-accent); width: 100%; height: 44px; margin: 0; }

  .seg { display: flex; gap: 0.4rem; }
  .seg button {
    flex: 1;
    min-height: 44px;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    padding: 0.5rem 0.4rem;
    border-radius: var(--radius);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg);
    color: var(--color-text-muted);
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .seg button:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .seg button.is-active { background: var(--color-accent); border-color: var(--color-accent); color: #fff; }

  .calc__result { padding: 1.75rem 1.5rem; display: flex; flex-direction: column; gap: 1.25rem; }
  .result__row { display: grid; grid-template-columns: 1fr 1fr; }
  .result__block { text-align: center; padding: 0.25rem 0; }
  .result__block + .result__block { border-left: 1px solid var(--color-border); }
  .result__num { font-family: var(--font-display); font-size: 3.4rem; font-weight: 800; line-height: 1; letter-spacing: -0.03em; color: var(--color-text); font-variant-numeric: tabular-nums; }
  .result__unit { font-family: var(--font-display); font-size: 1.3rem; font-weight: 700; color: var(--color-accent); margin-left: 0.2rem; }
  .result__cap { margin: 0.35rem 0 0; font-family: var(--font-ui); font-weight: 500; font-size: 0.9rem; color: var(--color-text-muted); }

  .result__meta { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; margin: 0; padding-top: 1rem; border-top: 1px solid var(--color-border); }
  .result__meta dt { font-family: var(--font-ui); font-weight: 600; font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--color-text-faint); }
  .result__meta dd { margin: 0.2rem 0 0; font-family: var(--font-ui); font-weight: 600; font-size: 1.05rem; }
  .result__tip { display: flex; gap: 0.6rem; align-items: flex-start; margin: 0; padding: 0.9rem 1rem; font-size: 0.95rem; line-height: 1.5; color: var(--color-text-muted); background: var(--color-bg-soft); border: 1px solid var(--color-border); border-radius: var(--radius); }
  .result__tip :global(svg) { flex: none; color: var(--color-accent); margin-top: 0.1em; }

  .calc__note { margin: 2rem 0 0; color: var(--color-text-muted); font-size: 0.98rem; max-width: 62ch; }

  .dose { margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--color-border); max-width: var(--measure); }
  .dose h2 { margin: 0 0 0.6rem; font-size: 1.35rem; }
  .dose h2:not(:first-child) { margin-top: 2rem; }
  .dose p { line-height: 1.65; }
  .dose .table-wrap { margin: 1rem 0; }
  .faq { border-bottom: 1px solid var(--color-border); padding: 0.5rem 0; }
  .faq summary { cursor: pointer; font-family: var(--font-ui); font-weight: 700; min-height: 44px; display: flex; align-items: center; }
  .faq p { margin: 0.4rem 0 0.6rem; color: var(--color-text-muted); }
  .dose__src { margin-top: 1.25rem; font-size: 0.92rem; color: var(--color-text-muted); }
  .methodes { margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--color-border); }
  .methodes__title { margin: 0 0 0.5rem; font-size: 1.35rem; }
  .methodes__lede { margin: 0 0 1.25rem; color: var(--color-text-muted); max-width: 62ch; line-height: 1.55; }
  .methodes__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.75rem; }
  .methodes__list a { display: flex; flex-direction: column; gap: 0.25rem; min-height: 44px; height: 100%; padding: 0.9rem 1rem; border: 1px solid var(--color-border-strong); border-radius: var(--radius); background: var(--color-surface); color: var(--color-text); text-decoration: none; transition: border-color 0.15s ease; }
  .methodes__list a:hover { border-color: var(--color-accent); }
  .methodes__name { font-family: var(--font-ui); font-weight: 700; font-size: 1rem; }
  .methodes__list a:hover .methodes__name { color: var(--color-accent); }
  .methodes__hint { font-size: 0.9rem; line-height: 1.45; color: var(--color-text-muted); }

  @media (max-width: 720px) { .calc__grid { grid-template-columns: 1fr; } }
  @media (max-width: 400px) { .result__num { font-size: 2.8rem; } }
</style>
