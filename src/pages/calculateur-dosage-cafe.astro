---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../siteConfig';
---

<BaseLayout
  title="Calculateur de dosage café"
  description={`Combien de café et d'eau pour un café parfait ? Indique ta méthode et ton nombre de tasses, notre calculateur gratuit te donne les grammes exacts. ${siteConfig.name}.`}
>
  <PageHead
    title="Calculateur de dosage café"
    lede="Le bon café, c’est d’abord le bon ratio. Choisis ta méthode et ton nombre de tasses : tu obtiens les grammes de café et la quantité d’eau tout de suite."
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Outils', href: '/outils/' }, { label: 'Calculateur de dosage' }]}
    width="narrow"
  />

  <section class="container calc">
    <div class="calc__grid">
      <form class="calc__controls" id="calc-form" aria-label="Réglages du dosage">
        <label class="field">
          <span class="field__label">Méthode</span>
          <span class="select">
            <select id="method">
              <option value="filtre">Café filtre / cafetière</option>
              <option value="v60">V60 / pour-over</option>
              <option value="piston">Piston (French press)</option>
              <option value="italienne">Cafetière italienne (moka)</option>
              <option value="expresso">Expresso</option>
            </select>
            <Icon name="chevron-down" size={18} />
          </span>
        </label>

        <label class="field">
          <span class="field__label">Nombre de tasses <b id="cups-val">2</b></span>
          <input type="range" id="cups" min="1" max="12" value="2" step="1" />
        </label>

        <div class="field">
          <span class="field__label">Intensité</span>
          <div class="seg" role="group" aria-label="Intensité">
            <button type="button" data-s="doux">Doux</button>
            <button type="button" data-s="normal" class="is-active" aria-pressed="true">Normal</button>
            <button type="button" data-s="corse">Corsé</button>
          </div>
        </div>
      </form>

      <div class="calc__result" aria-live="polite">
        <div class="result__row">
          <div class="result__block">
            <span class="result__num" id="out-coffee">33</span><span class="result__unit">g</span>
            <p class="result__cap">de café moulu</p>
          </div>
          <div class="result__block">
            <span class="result__num" id="out-water">250</span><span class="result__unit" id="out-water-unit">ml</span>
            <p class="result__cap">d’eau</p>
          </div>
        </div>
        <dl class="result__meta">
          <div><dt>Mouture conseillée</dt><dd id="out-grind">moyenne</dd></div>
          <div><dt>Ratio café / eau</dt><dd id="out-ratio">1 : 16,5</dd></div>
        </dl>
        <p class="result__tip"><Icon name="bulb" size={18} /><span id="out-tip"></span></p>
      </div>
    </div>

    <p class="calc__note">
      Repère de base : un ratio autour de <b>1 g de café pour 16 à 17 g d’eau</b> pour le filtre.
      Ajuste ensuite à ton goût : ces chiffres sont un excellent point de départ, pas une règle figée.
      Pour la mouture et le geste, vois <a href="/methodes-cafe/">le panorama des méthodes</a> et nos <a href="/guides/">guides</a>.
    </p>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var M = {
      filtre:    { cup: 125, ratio: 16.5, grind: 'moyenne',       tip: 'Verse l’eau à ~93 °C en plusieurs fois pour une extraction régulière.' },
      v60:       { cup: 220, ratio: 16,   grind: 'moyenne-fine',  tip: 'Fais une pré-infusion (bloom) de 30 s avant de continuer à verser.' },
      piston:    { cup: 220, ratio: 15,   grind: 'grossière',     tip: 'Laisse infuser 4 minutes avant de presser doucement.' },
      italienne: { cup: 60,  ratio: 10,   grind: 'fine',          tip: 'Remplis le panier sans tasser, et retire du feu dès que ça monte.' },
      expresso:  { cup: 30,  ratio: 3,    grind: 'très fine',     tip: 'Vise 25 à 30 s d’extraction pour un espresso équilibré.' },
    };
    var STRENGTH = { doux: 1.08, normal: 1, corse: 0.92 };
    var strength = 'normal';

    var method = document.getElementById('method');
    var cups = document.getElementById('cups');
    var cupsVal = document.getElementById('cups-val');
    var outCoffee = document.getElementById('out-coffee');
    var outWater = document.getElementById('out-water');
    var outWaterUnit = document.getElementById('out-water-unit');
    var outGrind = document.getElementById('out-grind');
    var outRatio = document.getElementById('out-ratio');
    var outTip = document.getElementById('out-tip');
    var segBtns = document.querySelectorAll('.seg button');

    function fr(n, d) { return n.toLocaleString('fr-FR', { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 }); }

    function update() {
      var m = M[method.value];
      var n = parseInt(cups.value, 10);
      cupsVal.textContent = n;
      var ratio = m.ratio * STRENGTH[strength];
      var waterMl = n * m.cup;
      var coffeeG = waterMl / ratio;
      coffeeG = Math.round(coffeeG * 2) / 2; // arrondi 0,5 g

      outCoffee.textContent = fr(coffeeG, coffeeG % 1 === 0 ? 0 : 1);
      if (waterMl >= 1000) {
        outWater.textContent = fr(waterMl / 1000, 1);
        outWaterUnit.textContent = 'L';
      } else {
        outWater.textContent = fr(waterMl);
        outWaterUnit.textContent = 'ml';
      }
      outGrind.textContent = m.grind;
      outRatio.textContent = '1 : ' + fr(ratio, 1);
      outTip.textContent = m.tip;
    }

    method.addEventListener('change', update);
    cups.addEventListener('input', update);
    segBtns.forEach(function (b) {
      b.addEventListener('click', function () {
        strength = b.getAttribute('data-s');
        segBtns.forEach(function (x) { x.classList.remove('is-active'); x.setAttribute('aria-pressed', 'false'); });
        b.classList.add('is-active'); b.setAttribute('aria-pressed', 'true');
        update();
      });
    });
    update();
  })();
</script>

<style>
  .calc { padding-top: 2rem; padding-bottom: 1rem; }
  .calc__grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 1.25rem; align-items: stretch; }
  .calc__controls, .calc__result {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
  }
  .calc__controls { padding: 1.5rem; display: flex; flex-direction: column; gap: 1.4rem; }

  .field { display: flex; flex-direction: column; gap: 0.55rem; }
  .field__label { font-family: var(--font-ui); font-weight: 600; font-size: 0.95rem; }
  .field__label b { color: var(--color-accent); font-variant-numeric: tabular-nums; }
  .select { position: relative; display: block; }
  .select :global(svg) { position: absolute; right: 0.8rem; top: 50%; transform: translateY(-50%); pointer-events: none; color: var(--color-text-faint); }
  select {
    width: 100%;
    min-height: 44px;
    padding: 0.6rem 2.4rem 0.6rem 0.8rem;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 1rem;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    appearance: none;
    -webkit-appearance: none;
  }
  select:hover { border-color: var(--color-accent); }
  input[type='range'] { accent-color: var(--color-accent); width: 100%; height: 44px; margin: 0; }

  .seg { display: flex; gap: 0.4rem; }
  .seg button {
    flex: 1;
    min-height: 44px;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    padding: 0.5rem 0.4rem;
    border-radius: var(--radius);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg);
    color: var(--color-text-muted);
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .seg button:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .seg button.is-active { background: var(--color-accent); border-color: var(--color-accent); color: #fff; }

  .calc__result { padding: 1.75rem 1.5rem; display: flex; flex-direction: column; gap: 1.25rem; }
  .result__row { display: grid; grid-template-columns: 1fr 1fr; }
  .result__block { text-align: center; padding: 0.25rem 0; }
  .result__block + .result__block { border-left: 1px solid var(--color-border); }
  .result__num { font-family: var(--font-display); font-size: 3.4rem; font-weight: 800; line-height: 1; letter-spacing: -0.03em; color: var(--color-text); font-variant-numeric: tabular-nums; }
  .result__unit { font-family: var(--font-display); font-size: 1.3rem; font-weight: 700; color: var(--color-accent); margin-left: 0.2rem; }
  .result__cap { margin: 0.35rem 0 0; font-family: var(--font-ui); font-weight: 500; font-size: 0.9rem; color: var(--color-text-muted); }

  .result__meta { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; margin: 0; padding-top: 1rem; border-top: 1px solid var(--color-border); }
  .result__meta dt { font-family: var(--font-ui); font-weight: 600; font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--color-text-faint); }
  .result__meta dd { margin: 0.2rem 0 0; font-family: var(--font-ui); font-weight: 600; font-size: 1.05rem; }
  .result__tip { display: flex; gap: 0.6rem; align-items: flex-start; margin: 0; padding: 0.9rem 1rem; font-size: 0.95rem; line-height: 1.5; color: var(--color-text-muted); background: var(--color-bg-soft); border: 1px solid var(--color-border); border-radius: var(--radius); }
  .result__tip :global(svg) { flex: none; color: var(--color-accent); margin-top: 0.1em; }

  .calc__note { margin: 2rem 0 0; color: var(--color-text-muted); font-size: 0.98rem; max-width: 62ch; }

  @media (max-width: 720px) { .calc__grid { grid-template-columns: 1fr; } }
  @media (max-width: 400px) { .result__num { font-size: 2.8rem; } }
</style>
